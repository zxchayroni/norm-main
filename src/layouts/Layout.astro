---
import { ClientRouter } from 'astro:transitions';
import { SESSION_IDLE_TIMEOUT_MS } from '../lib/session-policy';

interface Props {
	title?: string;
}

const { title = 'НормАрхив — электронный архив документов' } = Astro.props;
---
<!doctype html>
<html lang="ru">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#f7f8fa" />
		<meta name="description" content="Электронный архив нормативных документов организации" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<ClientRouter />
		<script is:inline>
			try {
				const savedTheme = localStorage.getItem('normarchive-theme');
				if (savedTheme === 'dark' || savedTheme === 'light') {
					document.documentElement.dataset.theme = savedTheme;
				}
				document.querySelector('meta[name="theme-color"]').content =
					document.documentElement.dataset.theme === 'dark' ? '#090a0b' : '#f7f8fa';
			} catch {
				// Theme preference is optional when browser storage is unavailable.
			}
		</script>
	</head>
	<body data-session-idle-timeout={SESSION_IDLE_TIMEOUT_MS} data-session-user-id={Astro.locals.user?.id ?? ''}>
		<slot />
		<script>
			function syncThemeButtons() {
				const dark = document.documentElement.dataset.theme === 'dark';
				document.querySelector<HTMLMetaElement>('meta[name="theme-color"]')!.content = dark ? '#090a0b' : '#f7f8fa';
				document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((button) => {
					button.setAttribute('aria-pressed', String(dark));
					button.setAttribute('aria-label', dark ? 'Включить светлую тему' : 'Включить тёмную тему');
					button.title = dark ? 'Включить светлую тему' : 'Включить тёмную тему';
				});
			}
			function restoreSavedTheme() {
				try {
					const savedTheme = localStorage.getItem('normarchive-theme');
					if (savedTheme === 'dark' || savedTheme === 'light') {
						document.documentElement.dataset.theme = savedTheme;
					}
				} catch {
					// Keep the current theme when browser storage is unavailable.
				}
				syncThemeButtons();
			}
			restoreSavedTheme();
			document.addEventListener('astro:page-load', restoreSavedTheme);
			let lastSessionRefresh = Date.now();
			let sessionRefreshPending = false;
			const sessionIdleTimeoutMs = Number(document.body.dataset.sessionIdleTimeout);
			const sessionUserId = document.body.dataset.sessionUserId;
			const lastActivityStorageKey = sessionUserId ? `normarchive-last-activity-${sessionUserId}` : null;
			let lastActivityAt = Date.now();
			let lastActivityPersistedAt = 0;
			let idleTimer;
			let idleLogoutStarted = false;
			const sessionActivityChannel = 'BroadcastChannel' in window
				? new BroadcastChannel('normarchive-session-activity')
				: null;

			async function refreshActiveSession() {
				if (
					!document.querySelector('.sidebar') ||
					document.visibilityState !== 'visible' ||
					sessionRefreshPending ||
					Date.now() - lastSessionRefresh < 5 * 60 * 1000
				) return;
				lastSessionRefresh = Date.now();
				sessionRefreshPending = true;
				try {
					const response = await fetch('/api/auth/me', { credentials: 'same-origin' });
					if (!response.ok && response.status !== 401) {
						throw new Error(`Ошибка обновления сессии (${response.status}).`);
					}
					if (response.status === 401) {
						window.dispatchEvent(new Event('normarchive-session-expired'));
					}
				} catch (error) {
					console.error('Не удалось обновить активную сессию:', error);
				} finally {
					sessionRefreshPending = false;
				}
			}

			function readSharedLastActivity() {
				if (!lastActivityStorageKey) return lastActivityAt;
				try {
					const sharedTimestamp = Number(localStorage.getItem(lastActivityStorageKey));
					if (Number.isFinite(sharedTimestamp)) lastActivityAt = Math.max(lastActivityAt, sharedTimestamp);
				} catch (error) {
					console.error('Не удалось проверить активность сессии в других вкладках:', error);
				}
				return lastActivityAt;
			}

			function finishIdleSession() {
				if (idleLogoutStarted) return;
				const remaining = sessionIdleTimeoutMs - (Date.now() - readSharedLastActivity());
				if (remaining > 0) {
					idleTimer = window.setTimeout(finishIdleSession, remaining);
					return;
				}
				idleLogoutStarted = true;
				window.dispatchEvent(new Event('normarchive-session-expired'));
				void fetch('/api/auth/logout', { method: 'POST', credentials: 'same-origin' })
					.then((response) => {
						if (!response.ok && response.status !== 401) {
							throw new Error(`Сервер не подтвердил завершение неактивной сессии (${response.status}).`);
						}
					})
					.catch((error) => console.error('Не удалось завершить неактивную сессию на сервере:', error))
					.finally(() => window.location.assign('/login?expired=1'));
			}

			function scheduleIdleCheck() {
				window.clearTimeout(idleTimer);
				if (!document.querySelector('.sidebar') || !sessionUserId) return;
				const remaining = sessionIdleTimeoutMs - (Date.now() - readSharedLastActivity());
				idleTimer = window.setTimeout(finishIdleSession, Math.max(remaining, 0));
			}

			function recordSessionActivity(broadcast = true) {
				if (!sessionUserId || !document.querySelector('.sidebar') || idleLogoutStarted) return;
				lastActivityAt = Date.now();
				lastActivityPersistedAt = lastActivityAt;
				scheduleIdleCheck();
				void refreshActiveSession();
				if (lastActivityStorageKey) {
					try {
						localStorage.setItem(lastActivityStorageKey, String(lastActivityAt));
					} catch (error) {
						console.error('Не удалось синхронизировать активность сессии между вкладками:', error);
					}
				}
				if (broadcast) sessionActivityChannel?.postMessage({ userId: sessionUserId, timestamp: lastActivityAt });
			}

			function initializeSessionActivity() {
				if (!document.querySelector('.sidebar') || !sessionUserId) {
					window.clearTimeout(idleTimer);
					return;
				}
				readSharedLastActivity();
				recordSessionActivity();
			}

			for (const eventName of ['pointerdown', 'keydown', 'input', 'touchstart']) {
				document.addEventListener(eventName, () => recordSessionActivity(), { passive: true });
			}
			let lastContinuousActivityAt = 0;
			for (const eventName of ['wheel', 'scroll']) {
				document.addEventListener(eventName, () => {
					if (Date.now() - lastContinuousActivityAt < 1000) return;
					lastContinuousActivityAt = Date.now();
					recordSessionActivity();
				}, { passive: true });
			}
			document.addEventListener('pointermove', () => {
				if (Date.now() - lastActivityPersistedAt >= 2000) recordSessionActivity();
			}, { passive: true });
			document.addEventListener('visibilitychange', () => {
				if (document.visibilityState === 'visible') scheduleIdleCheck();
			});
			window.addEventListener('storage', (event) => {
				if (!lastActivityStorageKey || event.key !== lastActivityStorageKey) return;
				const timestamp = Number(event.newValue);
				if (Number.isFinite(timestamp) && timestamp > lastActivityAt) {
					lastActivityAt = timestamp;
					scheduleIdleCheck();
				}
			});
			sessionActivityChannel?.addEventListener('message', (event) => {
				if (event.data?.userId !== sessionUserId || !Number.isFinite(event.data?.timestamp)) return;
				if (event.data.timestamp > lastActivityAt) {
					lastActivityAt = event.data.timestamp;
					scheduleIdleCheck();
				}
			});
			initializeSessionActivity();
			document.addEventListener('astro:page-load', initializeSessionActivity);
			function updateProfileDisplay(update) {
				const displayName = [update?.lastName, update?.firstName]
					.filter((part) => typeof part === 'string' && part.trim())
					.join(' ') || update?.fullName;
				if (typeof displayName !== 'string' || !displayName.trim()) return;
				document.querySelectorAll('[data-profile-name]').forEach((element) => {
					element.textContent = displayName;
				});
				const initials = displayName.trim().split(/\s+/).slice(0, 2).map((part) => part[0]?.toLocaleUpperCase('ru') ?? '').join('');
				document.querySelectorAll('[data-profile-initials]').forEach((element) => {
					element.textContent = initials;
				});
			}
			window.addEventListener('normarchive-profile-updated', (event) => {
				updateProfileDisplay(event.detail);
			});
			if ('BroadcastChannel' in window) {
				const profileChannel = new BroadcastChannel('normarchive-profile');
				profileChannel.addEventListener('message', (event) => {
					updateProfileDisplay(event.data);
					window.dispatchEvent(new CustomEvent('normarchive-profile-updated', { detail: event.data }));
				});
			}
			function setMobileNavigation(open: boolean, restoreFocus = false) {
				document.documentElement.classList.toggle('mobile-nav-open', open);
				document.querySelectorAll<HTMLButtonElement>('[data-mobile-menu-toggle]').forEach((button) => {
					button.setAttribute('aria-expanded', String(open));
					button.setAttribute('aria-label', open ? 'Закрыть меню' : 'Открыть меню');
				});
				if (!open && restoreFocus) document.querySelector<HTMLButtonElement>('[data-mobile-menu-toggle]')?.focus();
			}
			document.addEventListener('astro:page-load', () => setMobileNavigation(false));
			document.addEventListener('click', (event) => {
				if (!(event.target instanceof Element)) return;
				const toggle = event.target.closest<HTMLButtonElement>('[data-mobile-menu-toggle]');
				if (toggle) {
					setMobileNavigation(document.documentElement.classList.contains('mobile-nav-open') === false);
					return;
				}
				if (event.target.closest('[data-mobile-nav-close], .sidebar a')) setMobileNavigation(false);
			});
			document.addEventListener('keydown', (event) => {
				if (event.key === 'Escape' && document.documentElement.classList.contains('mobile-nav-open')) {
					setMobileNavigation(false, true);
				}
			});
			document.addEventListener('click', (event) => {
				if (!(event.target instanceof Element)) return;
				const toggle = event.target.closest<HTMLButtonElement>('[data-theme-toggle]');
				if (!toggle) return;
				const nextTheme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
				document.documentElement.dataset.theme = nextTheme;
				try {
					localStorage.setItem('normarchive-theme', nextTheme);
				} catch {
					// Keep the theme for the current page even if it cannot be persisted.
				}
				syncThemeButtons();
			});
		</script>
	</body>
</html>

<style>
	@view-transition {
		navigation: auto;
	}

	::view-transition-old(root) {
		animation: page-out .16s ease both;
	}

	::view-transition-new(root) {
		animation: page-in .24s cubic-bezier(.2, .75, .25, 1) both;
	}

	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}

	@keyframes page-out {
		to { opacity: 0; }
	}

	@keyframes page-in {
		from { opacity: 0; transform: translateY(5px); }
		to { opacity: 1; transform: translateY(0); }
	}

	:global(dialog[open]) {
		animation: dialog-in .2s cubic-bezier(.2, .75, .25, 1) both;
	}

	:global(dialog[open]::backdrop) {
		animation: backdrop-in .18s ease both;
	}


	@keyframes dialog-in {
		from { opacity: 0; transform: translateY(8px) scale(.985); }
		to { opacity: 1; transform: translateY(0) scale(1); }
	}

	@keyframes backdrop-in {
		from { background-color: rgb(15 24 19 / 0%); }
		to { background-color: rgb(15 24 19 / 42%); }
	}

	:global(.theme-toggle) {
		align-items: center;
		background: #f5f8f6;
		border: 1px solid #e1e9e4;
		border-radius: 10px;
		color: #426653;
		cursor: pointer;
		display: inline-flex;
		height: 40px;
		justify-content: center;
		position: relative;
		transition: background .2s ease, border-color .2s ease, color .2s ease, transform .2s ease;
		width: 40px;
	}

	:global(.theme-toggle:hover) { background: #eaf3ed; border-color: #c9ddcf; transform: translateY(-1px); }
	:global(.theme-toggle:focus-visible) { outline: 3px solid #75ad8a55; outline-offset: 2px; }
	:global(.theme-toggle svg) { fill: none; height: 19px; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.6; width: 19px; }
	:global(.theme-toggle .moon-icon) { display: none; }
	:global(html[data-theme="dark"] .theme-toggle) { background: #303a34; border-color: #46534a; color: #c4dfcc; }
	:global(html[data-theme="dark"] .theme-toggle:hover) { background: #3a473f; border-color: #5e7967; }
	:global(html[data-theme="dark"] .theme-toggle .sun-icon) { display: none; }
	:global(html[data-theme="dark"] .theme-toggle .moon-icon) { display: block; }

	:global(.mobile-menu-toggle) {
		align-items: center;
		background: #203832;
		border: 1px solid #355048;
		border-radius: 9px;
		color: #dceae2;
		cursor: pointer;
		display: none;
		height: 40px;
		justify-content: center;
		width: 40px;
	}

	:global(.mobile-menu-toggle svg) {
		fill: none;
		height: 20px;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-width: 1.7;
		width: 20px;
	}

	:global(.mobile-menu-toggle:focus-visible) { outline: 3px solid #a7d5bc; outline-offset: 2px; }
	:global(.mobile-nav-backdrop) { background: rgb(12 22 17 / 48%); border: 0; display: none; inset: 0; position: fixed; z-index: 2; }
	:global(html.mobile-nav-open) { overflow: hidden; }
	:global(html.mobile-nav-open .mobile-nav-backdrop) { animation: backdrop-in .2s ease both; display: block; }

	@media (max-width: 760px) {
		:global(.mobile-menu-toggle) { display: inline-flex; }
		:global(html) { overflow-x: clip; }
	}

	@media (prefers-reduced-motion: reduce) {
		:global(.theme-toggle) { transition: none; }
		:global(.mobile-menu-toggle), :global(.mobile-nav-backdrop) { transition: none; }
		:global(.sidebar) { transition: none; }
		:global(html.mobile-nav-open .mobile-nav-backdrop) { animation: none; }
		:global(dialog[open]),
		:global(dialog[open]::backdrop) { animation: none; }
		::view-transition-group(*),
		::view-transition-old(*),
		::view-transition-new(*) {
			animation-duration: 0s !important;
		}
		@keyframes page-out { to { opacity: 1; } }
		@keyframes page-in { to { opacity: 1; transform: none; } }
	}
</style>
