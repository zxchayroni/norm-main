	.management-tab { background: transparent; border: 0; border-bottom: 2px solid transparent; color: #75827a; cursor: pointer; font-size: 13px; font-weight: 600; margin-bottom: -1px; padding: 12px 16px; }
	.management-tab:hover { color: #267a57; }
	.management-tab.active { border-bottom-color: #267a57; color: #267a57; }
	.management-tab:focus-visible { outline: 2px solid #69a982; outline-offset: -2px; }
	.panel-hint { margin: 18px 0; }
	.primary { background: #267a57; border: 1px solid #267a57; border-radius: 7px; box-shadow: 0 2px 4px #236e5018; color: white; cursor: pointer; font-size: 12px; font-weight: 650; min-height: 42px; padding: 0 16px; transition: background .15s ease, box-shadow .15s ease, transform .15s ease; }
