---
import Layout from '../../layouts/Layout.astro';

const section = Astro.params.section ?? '';
const titles: Record<string, string> = {
	users: 'Подразделения, пользователи и роли',
	dictionaries: 'Справочники',
	audit: 'Журнал действий',
	import: 'Импорт документов',
};
if (!titles[section]) return new Response('Страница не найдена.', { status: 404 });
const currentUser = Astro.locals.user;
if (currentUser?.role !== 'admin') return Astro.redirect('/');
const userInitials = currentUser.fullName.split(/\s+/).slice(0, 2).map((part) => part[0]?.toLocaleUpperCase('ru') ?? '').join('');
---

<Layout title={`${titles[section]} — НормАрхив`}>
	<div class="admin-shell" data-section={section}>
		<aside class="sidebar" aria-label="Основная навигация" transition:name="app-sidebar">
			<div class="sidebar-top">
				<a class="brand" href="/" aria-label="НормАрхив — главная">
					<img class="brand-logo" src="/logo.png" alt="" />
				</a>
				<button class="mobile-menu-toggle" type="button" data-mobile-menu-toggle aria-expanded="false" aria-label="Открыть меню">
					<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 5h14M3 10h14M3 15h14"/></svg>
				</button>
			</div>
			<div class="workspace-label">РАБОЧЕЕ ПРОСТРАНСТВО</div>
			<nav class="nav-list" aria-label="Рабочее пространство">
				<a class="nav-item" href="/">
					<svg viewBox="0 0 20 20" aria-hidden="true"><rect x="3" y="3.5" width="14" height="13" rx="2"/><path d="M3.5 8h13M8 8v8"/></svg>
					<span>Каталог документов</span>
				</a>
				<a class="nav-item" href="/templates">
					<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 2.8h7l4 4v10.4H5V2.8Z"/><path d="M12 3v4h4M8 11h5M8 14h5"/></svg>
					<span>Шаблоны документов</span>
				</a>
				<a class="nav-item" href="/knowledge-base">
					<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 3.5h12v13H4zM7 7h6M7 10h6M7 13h4"/></svg>
					<span>База знаний</span>
				</a>
			</nav>
			<div class="workspace-label nav-section-label">УПРАВЛЕНИЕ</div>
			<nav class="nav-list" aria-label="Управление">
				<a class:list={{ 'nav-item': true, selected: section === 'import' }} href="/admin/import" aria-current={section === 'import' ? 'page' : undefined}>
					<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 13V3.5M6.5 7 10 3.5 13.5 7M4 12.5v3A1.5 1.5 0 0 0 5.5 17h9a1.5 1.5 0 0 0 1.5-1.5v-3"/></svg>
					<span>Импорт документов</span>
				</a>
				<a class:list={{ 'nav-item': true, selected: section === 'users' }} href="/admin/users" aria-current={section === 'users' ? 'page' : undefined}>
					<svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="8" cy="7" r="3"/><path d="M2.8 16c.5-2.4 2.3-3.7 5.2-3.7s4.7 1.3 5.2 3.7M14 5.2a3 3 0 0 1 0 5.6m1.1 1.7c1.2.7 1.8 1.8 2.1 3.5"/></svg>
					<span>Подразделения, пользователи и роли</span>
				</a>
				<a class:list={{ 'nav-item': true, selected: section === 'audit' }} href="/admin/audit" aria-current={section === 'audit' ? 'page' : undefined}>
					<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 3h12v14H4zM7 7h6M7 10h6M7 13h3"/></svg>
					<span>Журнал действий</span>
				</a>
				<a class:list={{ 'nav-item': true, selected: section === 'dictionaries' }} href="/admin/dictionaries" aria-current={section === 'dictionaries' ? 'page' : undefined}>
					<svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="2.5"/><path d="m16.1 11.8 1.1.8-1.5 2.6-1.3-.5a6 6 0 0 1-1.4.8l-.2 1.4h-3l-.2-1.4a6 6 0 0 1-1.4-.8l-1.3.5-1.5-2.6 1.1-.8a6 6 0 0 1 0-1.6l-1.1-.8 1.5-2.6 1.3.5a6 6 0 0 1 1.4-.8l.2-1.4h3l.2 1.4a6 6 0 0 1 1.4.8l1.3-.5 1.5 2.6-1.1.8a6 6 0 0 1 0 1.6Z" transform="translate(-1 -1) scale(1.08)"/></svg>
					<span>Настройки</span>
				</a>
			</nav>
			<div class="sidebar-bottom">
				<div class="storage-card">
					<div class="storage-heading"><span>Диск</span><span data-storage-percent>Загрузка…</span></div>
					<div class="storage-track" role="progressbar" aria-label="Занято на диске сервера" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span data-storage-meter></span></div>
					<div class="storage-caption" data-storage-caption>Загружаем данные о хранилище…</div>
				</div>
				<a class="profile" href="/profile" aria-label="Открыть личный кабинет">
					<span class="avatar" data-profile-initials>{userInitials}</span>
					<span class="profile-copy"><strong data-profile-name>{currentUser.fullName}</strong><small>Администратор</small></span>
					<svg class="profile-more" viewBox="0 0 20 20" aria-hidden="true"><circle cx="4" cy="10" r="1"/><circle cx="10" cy="10" r="1"/><circle cx="16" cy="10" r="1"/></svg>
				</a>
				<button class="logout-button" id="admin-logout" type="button">Выйти из системы</button>
			</div>
		</aside>
		<button class="mobile-nav-backdrop" type="button" data-mobile-nav-close aria-label="Закрыть меню"></button>
		<main class="admin-main" transition:name="app-content">
			<header class="admin-topbar">
				<div class="breadcrumbs"><span>Управление</span><span class="crumb-divider">/</span><strong>{titles[section]}</strong></div>
				<button class="theme-toggle" type="button" data-theme-toggle aria-label="Включить тёмную тему" title="Включить тёмную тему" aria-pressed="false">
					<svg class="sun-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"/></svg>
					<svg class="moon-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5 8.5 8.5 0 1 0 20.5 14.2Z"/></svg>
				</button>
			</header>
		<section class="admin-content">
			<div class="heading">
				<div><p>АДМИНИСТРИРОВАНИЕ</p><h1>{titles[section]}</h1></div>
				{(section === 'users' || section === 'dictionaries') && <button class="primary" id="add-record" type="button">{section === 'users' ? '＋ Добавить подразделение' : '＋ Добавить'}</button>}
			</div>
			{section === 'import' && (
				<>
					<p class="hint">Загрузите CSV/XLSX-таблицу или ZIP-архив с файлами. В ZIP можно добавить <code>manifest.csv</code> или <code>manifest.xlsx</code> с колонками «Название», «Номер», «Дата», «Вид», «Статус», «Подразделение», «Описание», «Теги» и «Файл».</p>
					<form class="import-upload" id="import-form">
						<label>Файл импорта<input name="file" type="file" accept=".csv,.xlsx,.zip" required /></label>
						<button class="primary" type="submit" id="preview-import">Проверить и показать предпросмотр</button>
					</form>
					<div class="table-wrap import-table-wrap" id="import-table-wrap" hidden>
						<table><thead><tr><th>ДОКУМЕНТ</th><th>ФАЙЛ</th><th>СОВПАДЕНИЯ</th><th>ДЕЙСТВИЕ</th><th>ЦЕЛЕВОЙ ДОКУМЕНТ</th></tr></thead><tbody id="import-rows"></tbody></table>
						<div class="import-actions"><span id="import-summary"></span><button class="primary" id="commit-import" type="button">Выполнить импорт</button><button class="cancel" id="cancel-import" type="button">Отменить</button></div>
					</div>
				</>
			)}
			{section === 'users' && (
				<>
					<p class="hint">Создавайте подразделения и управляйте учётными записями с их ролями.</p>
					<div class="management-tabs" role="tablist" aria-label="Раздел управления">
						<button class="management-tab active" id="departments-tab" type="button" role="tab" aria-selected="true" aria-controls="departments-panel" data-management-tab="departments">Подразделения</button>
						<button class="management-tab" id="users-tab" type="button" role="tab" aria-selected="false" aria-controls="users-panel" data-management-tab="users">Пользователи и роли</button>
					</div>
					<section id="departments-panel" role="tabpanel" aria-labelledby="departments-tab">
						<p class="hint panel-hint">Подразделения появятся в списке при создании карточки документа.</p>
						<div class="table-wrap"><table><thead><tr><th>ПОДРАЗДЕЛЕНИЕ</th><th>ПОРЯДОК</th><th>СТАТУС</th><th></th></tr></thead><tbody id="departments-rows"></tbody></table></div>
					</section>
					<section id="users-panel" role="tabpanel" aria-labelledby="users-tab" hidden>
						<p class="hint panel-hint">Управление локальными учётными записями и ролями пользователей.</p>
						<div class="table-wrap"><table><thead><tr><th>ПОЛЬЗОВАТЕЛЬ</th><th>ЛОГИН</th><th>РОЛЬ</th><th>СТАТУС</th><th>ПОСЛЕДНИЙ ВХОД</th><th></th></tr></thead><tbody id="users-rows"></tbody></table></div>
					</section>
				</>
			)}
			{section === 'dictionaries' && (
				<>
					<p class="hint">Виды документов, статусы, подразделения и категории файлов.</p>
					<div class="dictionary-toolbar"><label>Тип справочника<select id="dictionary-type"><option value="">Все типы</option><option value="doc_type">Виды документов</option><option value="status">Статусы</option><option value="department">Подразделения</option><option value="file_kind">Типы файлов</option></select></label></div>
					<div class="table-wrap"><table><thead><tr><th>ТИП</th><th>НАЗВАНИЕ</th><th>ПОРЯДОК</th><th>СТАТУС</th><th></th></tr></thead><tbody id="dictionary-rows"></tbody></table></div>
				</>
			)}
			{section === 'audit' && (
				<>
					<p class="hint">История входов, изменений документов и операций с файлами.</p>
					<div class="audit-filters">
						<div class="audit-filters-heading"><strong>Фильтры журнала</strong><span>Можно использовать несколько фильтров одновременно</span></div>
						<label>ID пользователя<input id="audit-user" inputmode="numeric" placeholder="Например, 1" /></label>
						<label>Действие<select id="audit-action">
							<option value="">Все действия</option>
							<option value="login">Вход в систему</option><option value="login_failed">Неудачная попытка входа</option>
							<option value="logout">Выход из системы</option><option value="password_changed">Изменение пароля</option>
							<option value="user_created">Создание пользователя</option><option value="user_deleted">Удаление пользователя</option>
							<option value="document_created">Создание документа</option><option value="document_updated">Изменение документа</option><option value="document_deleted">Удаление документа</option>
							<option value="file_uploaded">Загрузка файла</option><option value="file_downloaded">Скачивание файла</option><option value="file_deleted">Удаление файла</option>
							<option value="file_imported">Импорт файла</option><option value="created_by_import">Создание документа при импорте</option>
							<option value="file_version_created">Создание версии файла</option><option value="file_version_restored">Восстановление версии файла</option><option value="file_edit_link_created">Создание ссылки для редактирования</option>
							<option value="dictionary_created">Создание записи справочника</option><option value="dictionary_updated">Изменение записи справочника</option><option value="dictionary_disabled">Отключение записи справочника</option>
						</select></label>
						<label>Тип объекта<select id="audit-object">
							<option value="">Все объекты</option><option value="user">Пользователь</option><option value="document">Документ</option>
							<option value="file">Файл</option><option value="version">Версия файла</option><option value="dictionary">Запись справочника</option>
						</select></label>
						<label>Начало периода<input id="audit-from" type="date" /></label>
						<label>Конец периода<input id="audit-to" type="date" /></label>
						<div class="audit-filter-actions"><button class="cancel" id="reset-audit" type="button">Сбросить</button><button class="primary" id="apply-audit" type="button">Показать записи</button></div>
					</div>
					<div class="audit-results-heading"><strong>События</strong><span id="audit-result-count">Последние записи</span></div>
					<div class="table-wrap audit-table-wrap"><table class="audit-table"><thead><tr><th>ДАТА И ВРЕМЯ</th><th>ПОЛЬЗОВАТЕЛЬ</th><th>ДЕЙСТВИЕ</th><th>ОБЪЕКТ</th><th>РЕЗУЛЬТАТ</th><th>IP-АДРЕС</th></tr></thead><tbody id="audit-rows"></tbody></table></div>
				</>
			)}
			<div class="feedback" id="feedback" role="status" aria-live="polite"></div>
		</section>
		</main>
	</div>

	<dialog id="admin-dialog">
		<form id="admin-form">
			<button class="close" id="close-dialog" type="button" aria-label="Закрыть">×</button>
			<h2 id="dialog-heading"></h2>
			<div id="dialog-fields"></div>
			<div class="form-error" id="form-error" hidden></div>
			<div class="form-actions"><button class="cancel" id="cancel-dialog" type="button">Отмена</button><button class="primary" type="submit">Сохранить</button></div>
		</form>
	</dialog>
</Layout>

<script define:vars={{ section, currentUserId: currentUser.id }}>
	document.addEventListener('astro:page-load', () => {
	const shell = document.querySelector('.admin-shell');
	if (!shell || shell.dataset.initialized === 'true') return;
	shell.dataset.initialized = 'true';
	const currentSection = shell.dataset.section;
	const feedback = document.querySelector('#feedback');
	const dialog = document.querySelector('#admin-dialog');
	const form = document.querySelector('#admin-form');
	const fields = document.querySelector('#dialog-fields');
	const formError = document.querySelector('#form-error');
	let editingId = null;
	let activeManagementTab = 'departments';

	function formatStorageBytes(bytes) {
		if (bytes < 1024) return `${bytes} Б`;
		const units = ['КБ', 'МБ', 'ГБ', 'ТБ', 'ПБ'];
		let value = bytes / 1024;
		let unit = 0;
		while (value >= 1024 && unit < units.length - 1) {
			value /= 1024;
			unit++;
		}
		return `${new Intl.NumberFormat('ru-RU', { maximumFractionDigits: 1 }).format(value)} ${units[unit]}`;
	}

	async function loadStorageUsage() {
		const caption = document.querySelector('[data-storage-caption]');
		const percent = document.querySelector('[data-storage-percent]');
		const track = document.querySelector('.storage-track');
		const meter = document.querySelector('[data-storage-meter]');
		try {
			const response = await fetch('/api/storage/usage');
			const payload = await response.json();
			if (!response.ok || payload.archiveBytes === undefined || payload.freeBytes === undefined || payload.usedPercent === undefined) {
				throw new Error(payload.error ?? `Ошибка сервера (${response.status}).`);
			}
			percent.textContent = `${new Intl.NumberFormat('ru-RU', { maximumFractionDigits: 1 }).format(payload.usedPercent)}%`;
			caption.textContent = `Архив: ${formatStorageBytes(payload.archiveBytes)} · Свободно: ${formatStorageBytes(payload.freeBytes)}`;
			meter.style.width = `${payload.usedPercent}%`;
			track.setAttribute('aria-valuenow', String(payload.usedPercent));
			track.setAttribute('aria-valuetext', `${payload.usedPercent}% диска занято`);
		} catch (error) {
			console.error('Не удалось загрузить сведения о хранилище:', error);
			percent.textContent = 'Недоступно';
			caption.textContent = error instanceof Error ? error.message : 'Не удалось получить сведения о хранилище.';
			track.setAttribute('aria-valuetext', 'Сведения о диске недоступны');
		}
	}

	const escapeHtml = (value) => String(value ?? '').replace(/[&<>"']/g, (character) => ({
		'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
	})[character]);

	function notify(message) {
		feedback.textContent = message;
		feedback.classList.add('visible');
		window.setTimeout(() => feedback.classList.remove('visible'), 3200);
	}

	function publishProfileUpdate(userId, values) {
		const update = {
			userId: String(userId),
			firstName: String(values.firstName ?? '').trim(),
			lastName: String(values.lastName ?? '').trim(),
			patronymic: String(values.patronymic ?? '').trim(),
			email: String(values.email ?? '').trim(),
			phone: String(values.phone ?? '').trim(),
		};
		update.fullName = [update.lastName, update.firstName, update.patronymic].filter(Boolean).join(' ');
		window.dispatchEvent(new CustomEvent('normarchive-profile-updated', { detail: update }));
		if ('BroadcastChannel' in window) {
			const profileChannel = new BroadcastChannel('normarchive-profile');
			profileChannel.postMessage(update);
			profileChannel.close();
		}
	}

	const handleSessionExpired = () => notify('Сессия завершилась. Войдите в систему снова.');
	window.addEventListener('normarchive-session-expired', handleSessionExpired);

	function field(label, name, type = 'text', attributes = '') {
		return `<label>${label}<input name="${name}" type="${type}" ${attributes} /></label>`;
	}

	async function requestJson(url, options = {}) {
		const response = await fetch(url, options);
		const contentType = response.headers.get('content-type') ?? '';
		const payload = contentType.includes('application/json') ? await response.json() : {};
		if (!response.ok) {
			throw new Error(response.status === 401 ? 'Сессия завершилась. Войдите в систему снова.' : payload.error ?? `Ошибка сервера (${response.status}).`);
		}
		return payload;
	}

	async function loadUsers() {
		const { users } = await requestJson('/api/admin/users');
		const body = document.querySelector('#users-rows');
		body.replaceChildren();
		for (const user of users) {
			const row = document.createElement('tr');
			row.innerHTML = `<td><strong>${escapeHtml(user.fullName)}</strong><small>${escapeHtml([user.email, user.phone].filter(Boolean).join(' · ') || 'Контакты не указаны')}</small></td>
				<td>${escapeHtml(user.username)}</td>
				<td><select class="role-select" aria-label="Роль ${escapeHtml(user.username)}">
					<option value="admin" ${user.role === 'admin' ? 'selected' : ''}>Администратор</option>
					<option value="editor" ${user.role === 'editor' ? 'selected' : ''}>Редактор</option>
					<option value="reader" ${user.role === 'reader' ? 'selected' : ''}>Читатель</option>
				</select></td>
				<td><button class="state-toggle ${user.isActive ? 'enabled' : ''}" type="button">${user.isActive ? 'Активен' : 'Заблокирован'}</button></td>
				<td>${user.lastLoginAt ? escapeHtml(new Date(user.lastLoginAt).toLocaleString('ru-RU')) : 'Не входил'}</td>
				<td><div class="user-actions"><button class="edit-user" type="button">Изменить</button><button class="delete-user" type="button" ${String(user.id) === String(currentUserId) ? 'disabled title="Нельзя удалить свою учётную запись"' : ''}>Удалить</button></div></td>`;
			const roleSelect = row.querySelector('.role-select');
			roleSelect.addEventListener('change', async () => {
				try { await requestJson(`/api/admin/users/${user.id}`, { method: 'PATCH', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ role: roleSelect.value }) }); notify('Роль обновлена.'); }
				catch (error) { notify(error.message); await loadUsers(); }
			});
			row.querySelector('.state-toggle').addEventListener('click', async () => {
				try { await requestJson(`/api/admin/users/${user.id}`, { method: 'PATCH', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ isActive: !user.isActive }) }); await loadUsers(); }
				catch (error) { notify(error.message); }
			});
			row.querySelector('.edit-user').addEventListener('click', () => openUserForm(user));
			row.querySelector('.delete-user').addEventListener('click', async (event) => {
				if (!(event.currentTarget instanceof HTMLButtonElement)) return;
				const button = event.currentTarget;
				if (button.disabled || !window.confirm(`Удалить учётную запись «${user.fullName}» (${user.username})? Документы и журнал действий сохранятся, восстановить учётную запись будет нельзя.`)) return;
				button.disabled = true;
				try {
					await requestJson(`/api/admin/users/${user.id}`, { method: 'DELETE' });
					await loadUsers();
					notify('Пользователь удалён.');
				} catch (error) {
					notify(error.message);
					button.disabled = false;
				}
			});
			body.append(row);
		}
	}

	function openUserForm(user = null) {
		editingId = user?.id ?? null;
		document.querySelector('#dialog-heading').textContent = user ? 'Изменить пользователя' : 'Новый пользователь';
		fields.innerHTML = `${field('Логин', 'username', 'text', `required maxlength="100" placeholder="Например, ivanov" ${user ? 'disabled' : ''}`)}
			${field('Имя', 'firstName', 'text', 'required maxlength="100" autocomplete="given-name"')}
			${field('Фамилия', 'lastName', 'text', 'maxlength="100" autocomplete="family-name"')}
			${field('Отчество', 'patronymic', 'text', 'maxlength="100" autocomplete="additional-name"')}
			${field('Электронная почта', 'email', 'email', 'maxlength="320" placeholder="name@example.com"')}
			${field('Телефон', 'phone', 'tel', 'maxlength="40" autocomplete="tel"')}
			${field(user ? 'Новый пароль (оставьте пустым, чтобы не менять)' : 'Пароль (не менее 12 символов)', 'password', 'password', `${user ? '' : 'required'} minlength="12" maxlength="1024"`)}
			<label>Роль<select name="role"><option value="admin">Администратор</option><option value="editor">Редактор</option><option value="reader">Читатель</option></select></label>`;
		if (user) {
			form.elements.namedItem('firstName').value = user.firstName;
			form.elements.namedItem('lastName').value = user.lastName;
			form.elements.namedItem('patronymic').value = user.patronymic;
			form.elements.namedItem('email').value = user.email ?? '';
			form.elements.namedItem('phone').value = user.phone ?? '';
			form.elements.namedItem('role').value = user.role;
		}
		formError.hidden = true;
		dialog.showModal();
	}

	async function loadDictionaries() {
		const query = document.querySelector('#dictionary-type').value;
		const { items } = await requestJson(`/api/admin/dictionaries${query ? `?type=${encodeURIComponent(query)}` : ''}`);
		const body = document.querySelector('#dictionary-rows');
		body.replaceChildren();
		const labels = { doc_type: 'Вид документа', status: 'Статус', department: 'Подразделение', file_kind: 'Тип файла' };
		for (const item of items) {
			const row = document.createElement('tr');
			row.innerHTML = `<td>${labels[item.type]}</td><td>${escapeHtml(item.name)}</td><td>${item.sortOrder}</td><td>${item.isActive ? 'Активен' : 'Отключён'}</td>
				<td>${item.isActive ? '<button class="disable-item" type="button">Отключить</button>' : ''}</td>`;
			row.querySelector('.disable-item')?.addEventListener('click', async () => {
				try { await requestJson(`/api/admin/dictionaries/${item.id}`, { method: 'DELETE' }); await loadDictionaries(); notify('Запись отключена.'); }
				catch (error) { notify(error.message); }
			});
			body.append(row);
		}
	}

	async function loadDepartments() {
		const { items } = await requestJson('/api/admin/dictionaries?type=department');
		const body = document.querySelector('#departments-rows');
		body.replaceChildren();
		for (const item of items) {
			const row = document.createElement('tr');
			row.innerHTML = `<td><strong>${escapeHtml(item.name)}</strong></td><td>${item.sortOrder}</td><td>${item.isActive ? 'Активно' : 'Отключено'}</td>
				<td>${item.isActive ? '<button class="disable-item" type="button">Отключить</button>' : ''}</td>`;
			row.querySelector('.disable-item')?.addEventListener('click', async () => {
				try {
					await requestJson(`/api/admin/dictionaries/${item.id}`, { method: 'DELETE' });
					await loadDepartments();
					notify('Подразделение отключено.');
				} catch (error) {
					notify(error.message);
				}
			});
			body.append(row);
		}
	}

	function openDictionaryForm() {
		editingId = null;
		document.querySelector('#dialog-heading').textContent = 'Новая запись справочника';
		fields.innerHTML = `<label>Тип<select name="type" required>
			<option value="doc_type">Вид документа</option><option value="status">Статус</option>
			<option value="department">Подразделение</option><option value="file_kind">Тип файла</option>
		</select></label>${field('Название', 'name', 'text', 'required maxlength="200"')}${field('Порядок сортировки', 'sortOrder', 'number', 'min="0" max="100000" value="0"')}`;
		formError.hidden = true;
		dialog.showModal();
	}

	function openDepartmentForm() {
		editingId = null;
		document.querySelector('#dialog-heading').textContent = 'Новое подразделение';
		fields.innerHTML = `${field('Название подразделения', 'name', 'text', 'required maxlength="200"')}${field('Порядок сортировки', 'sortOrder', 'number', 'min="0" max="100000" value="0"')}`;
		formError.hidden = true;
		dialog.showModal();
	}

	async function loadAudit() {
		const params = new URLSearchParams();
		for (const [id, key] of [['audit-user', 'userId'], ['audit-action', 'action'], ['audit-object', 'object'], ['audit-from', 'from'], ['audit-to', 'to']]) {
			const value = document.getElementById(id).value.trim();
			if (value) params.set(key, value);
		}
		params.set('limit', '100');
		const { entries } = await requestJson(`/api/admin/audit?${params}`);
		const body = document.querySelector('#audit-rows');
		body.replaceChildren();
		const actionLabels = {
			login: 'Вход в систему', login_failed: 'Неудачная попытка входа', logout: 'Выход из системы',
			password_changed: 'Изменение пароля', user_created: 'Создание пользователя', user_deleted: 'Удаление пользователя',
			document_created: 'Создание документа', document_updated: 'Изменение документа', document_deleted: 'Удаление документа',
			file_uploaded: 'Загрузка файла', file_downloaded: 'Скачивание файла', file_deleted: 'Удаление файла',
			file_imported: 'Импорт файла', created_by_import: 'Создание документа при импорте',
			file_version_created: 'Создание версии файла', file_version_restored: 'Восстановление версии файла',
			file_edit_link_created: 'Создание ссылки для редактирования',
			dictionary_created: 'Создание записи справочника', dictionary_updated: 'Изменение записи справочника',
			dictionary_disabled: 'Отключение записи справочника',
		};
		const objectLabels = { user: 'Пользователь', document: 'Документ', file: 'Файл', version: 'Версия файла', dictionary: 'Запись справочника' };
		document.querySelector('#audit-result-count').textContent = `Найдено записей: ${entries.length}`;
		for (const entry of entries) {
			const row = document.createElement('tr');
			row.innerHTML = `<td class="audit-date">${escapeHtml(new Date(entry.createdAt).toLocaleString('ru-RU'))}</td>
				<td>${escapeHtml(entry.userName ?? (entry.userId ? `Удалённый пользователь · ID ${entry.userId}` : 'Система'))}</td>
				<td><span class="audit-action-label">${escapeHtml(actionLabels[entry.action] ?? entry.action)}</span></td>
				<td>${escapeHtml(objectLabels[entry.objectType] ?? entry.objectType)}${entry.objectId ? ` <span class="audit-object-id">№ ${escapeHtml(entry.objectId)}</span>` : ''}</td>
				<td><span class="result-badge ${entry.result === 'success' ? 'success' : 'failure'}">${entry.result === 'success' ? 'Успешно' : 'Ошибка'}</span></td>
				<td><code>${escapeHtml(entry.ipAddress ?? '—')}</code></td>`;
			body.append(row);
		}
	}

	let importBatchId = null;
	let importItems = [];
	function renderImportPreview(items) {
		const body = document.querySelector('#import-rows');
		body.replaceChildren();
		for (const item of items) {
			const row = document.createElement('tr');
			row.dataset.itemId = item.id;
			const duplicateText = item.error ?? (item.duplicates.length
				? item.duplicates.map((duplicate) => `№ ${duplicate.number || '—'} · ${duplicate.title}`).join('; ')
				: 'Совпадений нет');
			row.innerHTML = `<td><strong>${escapeHtml(item.title || 'Без названия')}</strong><small>${escapeHtml(item.number || 'Без номера')} · ${escapeHtml(item.date || 'Без даты')}</small></td>
				<td>${escapeHtml(item.fileName ?? '—')}</td><td class="${item.error ? 'import-error' : ''}">${escapeHtml(duplicateText)}</td>
				<td><select class="import-action" aria-label="Действие импорта">
					<option value="create" ${item.defaultAction === 'create' ? 'selected' : ''} ${item.error ? 'disabled' : ''}>Создать документ</option>
					<option value="attach" ${item.defaultAction === 'attach' ? 'selected' : ''} ${!item.fileName || !item.duplicates.length ? 'disabled' : ''}>Добавить файл к совпадению</option>
					<option value="skip" ${item.defaultAction === 'skip' ? 'selected' : ''}>Пропустить</option>
				</select></td><td><select class="import-target" aria-label="Документ для вложения"><option value="">Выберите при добавлении файла</option>
					${item.duplicates.map((duplicate) => `<option value="${escapeHtml(duplicate.id)}">№ ${escapeHtml(duplicate.number || '—')} · ${escapeHtml(duplicate.title)}</option>`).join('')}</select></td>`;
			row.querySelector('.import-action').addEventListener('change', () => {
				row.querySelector('.import-target').disabled = row.querySelector('.import-action').value !== 'attach';
			});
			row.querySelector('.import-target').disabled = row.querySelector('.import-action').value !== 'attach';
			body.append(row);
		}
		document.querySelector('#import-summary').textContent = `Записей: ${items.length}. Проверьте возможные совпадения и выберите действие для каждой строки.`;
		document.querySelector('#import-table-wrap').hidden = false;
	}

	async function submitImportPreview(event) {
		event.preventDefault();
		const button = document.querySelector('#preview-import');
		button.disabled = true;
		try {
			if (importBatchId) {
				await requestJson(`/api/admin/import/${importBatchId}`, { method: 'DELETE' });
				importBatchId = null;
			}
			const response = await fetch('/api/admin/import/preview', { method: 'POST', body: new FormData(document.querySelector('#import-form')) });
			const payload = await response.json();
			if (!response.ok) throw new Error(payload.error ?? 'Не удалось разобрать импорт.');
			importBatchId = payload.batchId;
			importItems = payload.items;
			renderImportPreview(importItems);
		} catch (error) {
			notify(error.message);
		} finally {
			button.disabled = false;
		}
	}

	async function cancelImport() {
		if (!importBatchId) return;
		try {
			await requestJson(`/api/admin/import/${importBatchId}`, { method: 'DELETE' });
			importBatchId = null;
			importItems = [];
			document.querySelector('#import-table-wrap').hidden = true;
			document.querySelector('#import-form').reset();
			notify('Предпросмотр импорта отменён.');
		} catch (error) { notify(error.message); }
	}

	async function commitImport() {
		if (!importBatchId) return;
		const items = [...document.querySelectorAll('#import-rows tr')].map((row) => {
			const action = row.querySelector('.import-action').value;
			const targetDocumentId = row.querySelector('.import-target').value;
			return { id: row.dataset.itemId, action, ...(action === 'attach' && targetDocumentId ? { targetDocumentId } : {}) };
		});
		const button = document.querySelector('#commit-import');
		button.disabled = true;
		try {
			const result = await requestJson(`/api/admin/import/${importBatchId}/commit`, {
				method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ items }),
			});
			const created = result.outcomes.filter((item) => item.action === 'create').length;
			const attached = result.outcomes.filter((item) => item.action === 'attach').length;
			const skipped = result.outcomes.filter((item) => item.action === 'skip').length;
			notify(`Импорт завершён: создано ${created}, добавлено файлов ${attached}, пропущено ${skipped}.`);
			importBatchId = null;
			document.querySelector('#import-table-wrap').hidden = true;
			document.querySelector('#import-form').reset();
		} catch (error) {
			notify(error.message);
		} finally {
			button.disabled = false;
		}
	}

	async function load() {
		try {
			if (currentSection === 'users') await loadDepartments();
			if (currentSection === 'users' && activeManagementTab === 'users') await loadUsers();
			if (currentSection === 'dictionaries') await loadDictionaries();
			if (currentSection === 'audit') await loadAudit();
		} catch (error) {
			notify(error.message);
		}
	}

	document.querySelectorAll('[data-management-tab]').forEach((tab) => {
		tab.addEventListener('click', () => {
			activeManagementTab = tab.dataset.managementTab;
			document.querySelectorAll('[data-management-tab]').forEach((item) => {
				const selected = item === tab;
				item.classList.toggle('active', selected);
				item.setAttribute('aria-selected', String(selected));
			});
			document.querySelector('#departments-panel').hidden = activeManagementTab !== 'departments';
			document.querySelector('#users-panel').hidden = activeManagementTab !== 'users';
			document.querySelector('#add-record').textContent = activeManagementTab === 'departments' ? '＋ Добавить подразделение' : '＋ Добавить пользователя';
			if (activeManagementTab === 'users') void loadUsers().catch((error) => notify(error.message));
		});
	});

	document.querySelector('#add-record')?.addEventListener('click', () => {
		if (currentSection === 'users' && activeManagementTab === 'departments') openDepartmentForm();
		else if (currentSection === 'users') openUserForm();
		if (currentSection === 'dictionaries') openDictionaryForm();
	});
	document.querySelector('#dictionary-type')?.addEventListener('change', () => void loadDictionaries().catch((error) => notify(error.message)));
	document.querySelector('#apply-audit')?.addEventListener('click', () => void loadAudit().catch((error) => notify(error.message)));
	document.querySelector('#reset-audit')?.addEventListener('click', () => {
		document.querySelector('.audit-filters').querySelectorAll('input, select').forEach((control) => { control.value = ''; });
		void loadAudit().catch((error) => notify(error.message));
	});
	document.querySelector('#import-form')?.addEventListener('submit', submitImportPreview);
	document.querySelector('#commit-import')?.addEventListener('click', commitImport);
	document.querySelector('#cancel-import')?.addEventListener('click', cancelImport);
	form.addEventListener('submit', async (event) => {
		event.preventDefault();
		formError.hidden = true;
		const data = new FormData(form);
		const payload = Object.fromEntries(data.entries());
		try {
			if (currentSection === 'users' && (editingId || activeManagementTab === 'users')) {
				const fullName = [payload.lastName, payload.firstName, payload.patronymic]
					.map((part) => String(part ?? '').trim())
					.filter(Boolean)
					.join(' ');
				if (!String(payload.firstName).trim() || fullName.length > 200) {
					throw new Error('Укажите имя и проверьте, что ФИО не длиннее 200 символов.');
				}
			}
			if (currentSection === 'users' && editingId) {
				delete payload.username;
				if (!payload.password) delete payload.password;
				await requestJson(`/api/admin/users/${editingId}`, { method: 'PATCH', headers: { 'content-type': 'application/json' }, body: JSON.stringify(payload) });
				await loadUsers();
				publishProfileUpdate(editingId, payload);
			} else if (currentSection === 'users' && activeManagementTab === 'users') {
				const created = await requestJson('/api/admin/users', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(payload) });
				await loadUsers();
				publishProfileUpdate(created.id, payload);
			} else if (currentSection === 'users') {
				await requestJson('/api/admin/dictionaries', {
					method: 'POST',
					headers: { 'content-type': 'application/json' },
					body: JSON.stringify({ ...payload, type: 'department', sortOrder: Number(payload.sortOrder) || 0 }),
				});
				await loadDepartments();
			} else {
				await requestJson('/api/admin/dictionaries', {
					method: 'POST',
					headers: { 'content-type': 'application/json' },
					body: JSON.stringify({ ...payload, sortOrder: Number(payload.sortOrder) || 0 }),
				});
				await loadDictionaries();
			}
			dialog.close();
			notify('Изменения сохранены.');
		} catch (error) {
			formError.textContent = error.message;
			formError.hidden = false;
		}
	});
	document.querySelector('#close-dialog').addEventListener('click', () => dialog.close());
	document.querySelector('#cancel-dialog').addEventListener('click', () => dialog.close());
	document.querySelector('#admin-logout')?.addEventListener('click', async () => {
		try {
			const response = await fetch('/api/auth/logout', { method: 'POST' });
			if (response.status === 503) {
				window.location.assign('/login?logout=partial');
				return;
			}
			if (!response.ok) throw new Error('Сервер не подтвердил завершение сессии.');
			window.location.assign('/login');
		} catch {
			notify('Не удалось завершить сеанс. Проверьте соединение и повторите попытку.');
		}
	});
	document.querySelector('nav[aria-label="Управление"]')?.addEventListener('click', (event) => {
		if (!(event.target instanceof Element)) return;
		const link = event.target.closest('a[aria-current="page"]');
		if (link) event.preventDefault();
	});
	const handleProfileUpdate = () => {
		if (currentSection === 'users') void loadUsers().catch((error) => notify(error.message));
	};
	window.addEventListener('normarchive-profile-updated', handleProfileUpdate);
	document.addEventListener('astro:before-swap', () => {
		window.removeEventListener('normarchive-profile-updated', handleProfileUpdate);
		window.removeEventListener('normarchive-session-expired', handleSessionExpired);
	}, { once: true });
	void load();
	void loadStorageUsage();
	});
</script>

