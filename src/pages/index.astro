---
import Layout from '../layouts/Layout.astro';

const currentYear = new Date().getFullYear();

const currentUser = Astro.locals.user;
const userInitials = currentUser?.fullName
	.split(/\s+/)
	.slice(0, 2)
	.map((part) => part[0]?.toLocaleUpperCase('ru') ?? '')
	.join('') ?? '??';
const roleLabels: Record<NonNullable<typeof currentUser>['role'], string> = {
	admin: 'Администратор',
	editor: 'Редактор',
	reader: 'Читатель',
};
---

<Layout>
	<div class="app-shell">
		<aside class="sidebar" aria-label="Основная навигация" transition:name="app-sidebar">
			<div class="sidebar-top">
				<a class="brand" href="/" aria-label="НормАрхив — главная">
					<img class="brand-logo" src="/logo.png" alt="" />
				</a>
				<button class="mobile-menu-toggle" type="button" data-mobile-menu-toggle aria-expanded="false" aria-label="Открыть меню">
					<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 5h14M3 10h14M3 15h14"/></svg>
				</button>
			</div>

			<div class="workspace-label">РАБОЧЕЕ ПРОСТРАНСТВО</div>
			<nav class="nav-list">
				<a class="nav-item selected" href="#catalog" data-catalog-view="all" aria-current="page">
					<svg viewBox="0 0 20 20" aria-hidden="true"><rect x="3" y="3.5" width="14" height="13" rx="2"/><path d="M3.5 8h13M8 8v8"/></svg>
					<span>Каталог документов</span><span class="nav-count">0</span>
				</a>
				<a class="nav-item" href="#catalog" data-catalog-view="recent">
					<svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="7"/><path d="M10 6v4l2.6 1.7"/></svg>
					<span>Недавние</span>
				</a>
				<button class="nav-item nav-button" type="button" data-catalog-view="favorites" aria-label="Избранное">
					<svg viewBox="0 0 20 20" aria-hidden="true"><path d="m10 2.8 2.2 4.5 5 .7-3.6 3.5.9 5-4.5-2.4-4.5 2.4.9-5-3.6-3.5 5-.7L10 2.8Z"/></svg>
					<span>Избранное</span>
				</button>
			</nav>

			{currentUser?.role === 'admin' && (
				<>
					<div class="workspace-label nav-section-label">УПРАВЛЕНИЕ</div>
					<nav class="nav-list">
						<a class="nav-item" href="/admin/import">
							<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 13V3.5M6.5 7 10 3.5 13.5 7M4 12.5v3A1.5 1.5 0 0 0 5.5 17h9a1.5 1.5 0 0 0 1.5-1.5v-3"/></svg>
							<span>Импорт документов</span>
						</a>
						<a class="nav-item" href="/admin/users">
							<svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="8" cy="7" r="3"/><path d="M2.8 16c.5-2.4 2.3-3.7 5.2-3.7s4.7 1.3 5.2 3.7M14 5.2a3 3 0 0 1 0 5.6m1.1 1.7c1.2.7 1.8 1.8 2.1 3.5"/></svg>
							<span>Подразделения, пользователи и роли</span>
						</a>
						<a class="nav-item" href="/admin/audit">
							<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 3h12v14H4zM7 7h6M7 10h6M7 13h3"/></svg>
							<span>Журнал действий</span>
						</a>
						<a class="nav-item" href="/admin/dictionaries">
							<svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="2.5"/><path d="m16.1 11.8 1.1.8-1.5 2.6-1.3-.5a6 6 0 0 1-1.4.8l-.2 1.4h-3l-.2-1.4a6 6 0 0 1-1.4-.8l-1.3.5-1.5-2.6 1.1-.8a6 6 0 0 1 0-1.6l-1.1-.8 1.5-2.6 1.3.5a6 6 0 0 1 1.4-.8l.2-1.4h3l.2 1.4a6 6 0 0 1 1.4.8l1.3-.5 1.5 2.6-1.1.8a6 6 0 0 1 0 1.6Z" transform="translate(-1 -1) scale(1.08)"/></svg>
							<span>Настройки</span>
						</a>
					</nav>
				</>
			)}

			<div class="sidebar-bottom">
				<div class="storage-card">
					<div class="storage-heading"><span>Диск</span><span data-storage-percent>Загрузка…</span></div>
					<div class="storage-track" role="progressbar" aria-label="Занято на диске сервера" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span data-storage-meter></span></div>
					<div class="storage-caption" data-storage-caption>Загружаем данные о хранилище…</div>
				</div>
				<a class="profile" href="/profile" aria-label="Открыть личный кабинет">
					<span class="avatar" data-profile-initials>{userInitials}</span>
					<span class="profile-copy"><strong data-profile-name>{currentUser?.fullName}</strong><small>{currentUser ? roleLabels[currentUser.role] : ''}</small></span>
					<svg class="profile-more" viewBox="0 0 20 20" aria-hidden="true"><circle cx="4" cy="10" r="1"/><circle cx="10" cy="10" r="1"/><circle cx="16" cy="10" r="1"/></svg>
				</a>
				<button class="logout-button" id="logout-button" type="button">Выйти из системы</button>
			</div>
		</aside>
		<button class="mobile-nav-backdrop" type="button" data-mobile-nav-close aria-label="Закрыть меню"></button>

		<main class="main-content" id="catalog" data-current-user={currentUser?.fullName ?? ''} data-user-role={currentUser?.role ?? ''} transition:name="app-content">
			<header class="topbar">
				<div class="breadcrumbs"><span>Рабочее пространство</span><span class="crumb-divider">/</span><strong>Каталог документов</strong></div>
				<div class="topbar-actions">
					<span class="environment-tag"><i></i> Демонстрационный режим</span>
					<button class="theme-toggle" type="button" data-theme-toggle aria-label="Включить тёмную тему" title="Включить тёмную тему" aria-pressed="false">
						<svg class="sun-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"/></svg>
						<svg class="moon-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5 8.5 8.5 0 1 0 20.5 14.2Z"/></svg>
					</button>
					<button class="icon-button help-button" type="button" aria-label="Справка">
						<svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="7"/><path d="M8 7.5a2.1 2.1 0 1 1 3.5 1.6c-.9.7-1.5 1.1-1.5 2.2M10 14.2v.1"/></svg>
					</button>
					<button class="icon-button notification-button" type="button" aria-label="Уведомления">
						<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M15.5 8a5.5 5.5 0 0 0-11 0c0 6-2 6-2 7.5h15C17.5 14 15.5 14 15.5 8ZM8 18h4"/></svg>
						<i></i>
					</button>
					<span class="topbar-avatar" data-profile-initials>{userInitials}</span>
					<button class="icon-button mobile-logout" id="mobile-logout-button" type="button" aria-label="Выйти из системы">
						<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M8 4H4v12h4M11 7l3 3-3 3M6 10h8"/></svg>
					</button>
				</div>
			</header>

			<div class="page-wrap">
				<section class="page-heading">
					<div>
						<div class="eyebrow"><span class="eyebrow-line"></span> ДОКУМЕНТООБОРОТ</div>
						<h1>Каталог документов</h1>
						<p class="page-subtitle">Все документы организации — в одном месте</p>
					</div>
					{currentUser?.role !== 'reader' && (
						<button class="primary-button" id="add-document" type="button">
							<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 4v12M4 10h12"/></svg>
							Добавить документ
						</button>
					)}
				</section>

				<section class="stats-grid" aria-label="Сводка по документам">
					<article class="stat-card">
						<div class="stat-top"><span class="stat-label">Всего документов</span><span class="stat-icon indigo"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 2.8h7l4 4v10.4H5V2.8Z"/><path d="M12 3v4h4M8 11h5M8 14h5"/></svg></span></div>
						<div class="stat-value">0</div>
						<div class="stat-foot"><span>В архиве</span></div>
					</article>
					<article class="stat-card">
						<div class="stat-top"><span class="stat-label">Действующие</span><span class="stat-icon green"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m4 10 4 4 8-8"/></svg></span></div>
						<div class="stat-value">0</div>
						<div class="stat-foot"><span class="stat-dot green-dot"></span><span>0% от общего числа</span></div>
					</article>
					<article class="stat-card">
						<div class="stat-top"><span class="stat-label">На согласовании</span><span class="stat-icon amber"><svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="7"/><path d="M10 6v4l2.5 1.5"/></svg></span></div>
						<div class="stat-value">0</div>
						<div class="stat-foot"><span class="stat-dot amber-dot"></span><span>Требуют внимания</span></div>
					</article>
					<article class="stat-card">
						<div class="stat-top"><span class="stat-label">Добавлено в этом месяце</span><span class="stat-icon blue"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 15 7 11l3 2 6-7"/><path d="M12 6h4v4"/></svg></span></div>
						<div class="stat-value">0</div>
						<div class="stat-foot"><span>С начала месяца</span></div>
					</article>
				</section>

				<section class="catalog-card" aria-labelledby="catalog-title">
					<div class="catalog-header">
						<div class="catalog-title-wrap">
							<div class="section-title-row"><h2 id="catalog-title">Все документы</h2><span class="total-pill" id="result-count">0</span></div>
							<p>Управляйте и находите нужные документы быстро</p>
						</div>
						<div class="catalog-tools">
							<label class="search-box">
								<svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.8" cy="8.8" r="5.8"/><path d="m13 13 4 4"/></svg>
								<input id="search-input" type="search" placeholder="Поиск по названию, номеру..." aria-label="Поиск по документам" />
								<kbd>⌘ K</kbd>
							</label>
							<button class="filter-button" id="filters-toggle" type="button" aria-expanded="false">
								<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 5h14M5.5 10h9M8 15h4"/></svg>
								Фильтры <span class="filter-indicator" id="filter-indicator"></span>
							</button>
							<button class="icon-button export-button" id="export-button" type="button" aria-label="Экспорт списка">
								<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 12V3m-3.5 3.5L10 3l3.5 3.5M4 11v5.5h12V11"/></svg>
							</button>
						</div>
					</div>

					<div class="filter-panel" id="filter-panel" hidden>
						<label>Статус
							<select id="status-filter">
								<option value="">Все статусы</option>
								<option>Действует</option>
								<option>На согласовании</option>
								<option>Утратил силу</option>
								<option>Архив</option>
								<option>Проект</option>
							</select>
						</label>
						<label>Вид документа
							<select id="type-filter">
								<option value="">Все виды</option>
								<option>Приказ</option>
								<option>Положение</option>
								<option>Регламент</option>
								<option>Инструкция</option>
								<option>Договор</option>
								<option>Методические рекомендации</option>
							</select>
						</label>
						<label>Подразделение<select id="department-filter"><option value="">Все подразделения</option></select></label>
						<label>Дата документа от<input id="date-from-filter" type="date" /></label>
						<label>до<input id="date-to-filter" type="date" /></label>
						<button class="clear-filters" id="clear-filters" type="button">Сбросить фильтры</button>
					</div>

					<div class="tabs-row">
						<div class="tabs" role="tablist" aria-label="Категория документов">
							<button class="tab active-tab" type="button" role="tab" aria-selected="true" data-tab="all">Все документы <span>0</span></button>
							<button class="tab" type="button" role="tab" aria-selected="false" data-tab="mine">Мои документы</button>
							<button class="tab" type="button" role="tab" aria-selected="false" data-tab="recent">Недавно изменённые</button>
						</div>
						<label class="sort-control">Сортировка:
							<select id="sort-select" aria-label="Сортировка документов">
								<option value="updated">По дате изменения</option>
								<option value="title">По названию</option>
								<option value="date">По дате документа</option>
								<option value="number">По номеру</option>
							</select>
							<svg viewBox="0 0 20 20" aria-hidden="true"><path d="m6 8 4 4 4-4"/></svg>
						</label>
					</div>

					<div class="table-scroll">
						<table>
							<thead><tr>
								<th class="check-col"><input type="checkbox" aria-label="Выбрать все документы" /></th>
								<th>НАЗВАНИЕ ДОКУМЕНТА</th>
								<th>НОМЕР / ДАТА</th>
								<th>ВИД</th>
								<th>СТАТУС</th>
								<th>ПОДРАЗДЕЛЕНИЕ</th>
								<th>ФАЙЛЫ</th>
								<th>ИЗМЕНЁН</th>
								<th><span class="sr-only">Действия</span></th>
							</tr></thead>
							<tbody id="document-rows"></tbody>
						</table>
						<div class="empty-state" id="empty-state" hidden>
							<span class="empty-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.5 15.5 5 5"/></svg></span>
							<strong>Документы не найдены</strong>
							<span>Измените поисковый запрос или сбросьте фильтры</span>
							<button type="button" id="empty-reset">Сбросить фильтры</button>
						</div>
					</div>

					<footer class="table-footer">
						<span>Показано <strong id="shown-count">0</strong> из 0 документов</span>
						<div class="pagination">
							<button class="page-arrow" type="button" aria-label="Предыдущая страница" disabled><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m12 4-6 6 6 6"/></svg></button>
							<button class="page-number current-page" type="button" aria-current="page">1</button>
							<button class="page-number" type="button">2</button>
							<button class="page-number" type="button">3</button>
							<span class="page-ellipsis">…</span>
							<button class="page-number" type="button">129</button>
							<button class="page-arrow" type="button" aria-label="Следующая страница"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m8 4 6 6-6 6"/></svg></button>
						</div>
					</footer>
				</section>

				<footer class="page-footer"><span>© {currentYear} НормАрхив</span><span>Версия 1.0.0 <i></i> Все данные защищены</span></footer>
			</div>
		</main>
	</div>

	<dialog class="document-dialog" id="document-dialog" aria-labelledby="dialog-title">
		<div class="dialog-top"><span class="dialog-file-icon"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 2.8h7l4 4v10.4H5V2.8Z"/><path d="M12 3v4h4M8 11h5M8 14h3"/></svg></span><button class="dialog-close" type="button" aria-label="Закрыть">×</button></div>
		<div class="dialog-kicker">КАРТОЧКА ДОКУМЕНТА</div>
		<h2 id="dialog-title"></h2>
		<div class="dialog-status"></div>
		<p class="dialog-description"></p>
		<div class="dialog-meta">
			<div><span>Номер и дата</span><strong class="meta-number"></strong></div>
			<div><span>Вид документа</span><strong class="meta-type"></strong></div>
			<div><span>Подразделение</span><strong class="meta-department"></strong></div>
			<div><span>Ответственный</span><strong class="meta-owner"></strong></div>
			<div><span>Файлы</span><strong class="meta-files"></strong></div>
			<div><span>Последнее изменение</span><strong class="meta-updated"></strong></div>
		</div>
		<section class="dialog-files-section">
			<div class="dialog-files-heading"><strong>Файлы документа</strong><button id="add-file-button" type="button" hidden>Загрузить файл</button></div>
			<div class="dialog-files" id="dialog-files"></div>
		</section>
		<div class="dialog-note" id="demo-note"><svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="7"/><path d="M10 9v4M10 6.5v.1"/></svg> Демонстрационная запись. Для файловых операций требуется подключение базы данных.</div>
		<div class="dialog-actions">
			<button class="danger-button" id="delete-document" type="button" hidden>Удалить</button>
			<button class="secondary-button" id="edit-document" type="button" hidden>Редактировать</button>
			<button class="secondary-button dialog-close-action" type="button">Закрыть</button>
		</div>
	</dialog>
	<dialog class="document-dialog form-dialog" id="document-form-dialog" aria-labelledby="form-dialog-title">
		<div class="dialog-top"><span class="dialog-file-icon"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 2.8h7l4 4v10.4H5V2.8Z"/><path d="M12 3v4h4M8 11h5M8 14h3"/></svg></span><button class="dialog-close form-close" type="button" aria-label="Закрыть">×</button></div>
		<div class="dialog-kicker">КАРТОЧКА ДОКУМЕНТА</div>
		<h2 id="form-dialog-title">Новый документ</h2>
		<form id="document-form">
			<div class="form-grid">
				<label class="field-wide">Название документа<input name="title" maxlength="300" required /></label>
				<label>Дата документа<input name="date" type="date" required /></label>
				<label>Вид документа<select name="type" required><option value="">Выберите вид</option></select></label>
				<label class="field-wide">Подразделение<select name="department" required><option value="">Выберите подразделение</option></select></label>
				<label class="field-wide">Файлы документа (необязательно; DOCX, XLSX, PDF — до 100 МБ каждый)<input name="files" type="file" multiple accept=".docx,.xlsx,.pdf,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" /></label>
			</div>
			<div class="form-error" id="form-error" role="alert" hidden></div>
			<div class="dialog-actions"><button class="secondary-button form-close" type="button">Отмена</button><button class="primary-button" type="submit" id="save-document">Сохранить документ</button></div>
		</form>
	</dialog>
	<div class="toast" id="toast" role="status" aria-live="polite"></div>
</Layout>

<script>
	document.addEventListener('astro:page-load', () => {
	if (!document.querySelector('#search-input')) return;
	const searchInput = document.querySelector<HTMLInputElement>('#search-input')!;
	const statusFilter = document.querySelector<HTMLSelectElement>('#status-filter')!;
	const typeFilter = document.querySelector<HTMLSelectElement>('#type-filter')!;
	const departmentFilter = document.querySelector<HTMLSelectElement>('#department-filter')!;
	const dateFromFilter = document.querySelector<HTMLInputElement>('#date-from-filter')!;
	const dateToFilter = document.querySelector<HTMLInputElement>('#date-to-filter')!;
	const sortSelect = document.querySelector<HTMLSelectElement>('#sort-select')!;
	let rows = Array.from(document.querySelectorAll<HTMLTableRowElement>('.document-row'));
	const emptyState = document.querySelector<HTMLDivElement>('#empty-state')!;
	const resultCount = document.querySelector<HTMLSpanElement>('#result-count')!;
	const shownCount = document.querySelector<HTMLElement>('#shown-count')!;
	const filterIndicator = document.querySelector<HTMLSpanElement>('#filter-indicator')!;
	const filterPanel = document.querySelector<HTMLDivElement>('#filter-panel')!;
	const dialog = document.querySelector<HTMLDialogElement>('#document-dialog')!;
	const formDialog = document.querySelector<HTMLDialogElement>('#document-form-dialog')!;
	const form = document.querySelector<HTMLFormElement>('#document-form')!;
	const toast = document.querySelector<HTMLDivElement>('#toast')!;
	const currentUserName = document.querySelector('.main-content')?.getAttribute('data-current-user') ?? '';
	const storageCaption = document.querySelector<HTMLElement>('[data-storage-caption]');
	const storagePercent = document.querySelector<HTMLElement>('[data-storage-percent]');
	const storageTrack = document.querySelector<HTMLElement>('.storage-track');
	const storageMeter = document.querySelector<HTMLElement>('[data-storage-meter]');
	let activeTab = 'all';
	let toastTimeout: number | undefined;
	let totalDocuments = 0;
	let resultTotal = 0;
	let currentPage = 0;
	let requestSequence = 0;
	let currentDocumentId: string | null = null;
	let editingDocumentId: string | null = null;
	let demoData = false;

	const getRowValue = (row: HTMLTableRowElement, key: string) => row.dataset[key] ?? '';
	const escapeHtml = (value: string) => value.replace(/[&<>"']/g, (character) => ({
		'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
	})[character]!);
	const statusClasses: Record<string, string> = {
		'Действует': 'active', 'На согласовании': 'review', 'Утратил силу': 'expired', 'Архив': 'archive', 'Проект': 'draft',
	};

	function formatStorageBytes(bytes: number): string {
		if (bytes < 1024) return `${bytes} Б`;
		const units = ['КБ', 'МБ', 'ГБ', 'ТБ', 'ПБ'];
		let value = bytes / 1024;
		let unit = 0;
		while (value >= 1024 && unit < units.length - 1) {
			value /= 1024;
			unit++;
		}
		return `${new Intl.NumberFormat('ru-RU', { maximumFractionDigits: 1 }).format(value)} ${units[unit]}`;
	}

	async function loadStorageUsage(): Promise<void> {
		try {
			const response = await fetch('/api/storage/usage');
			const payload = await response.json() as {
				archiveBytes?: number; freeBytes?: number; usedPercent?: number; error?: string;
			};
			if (!response.ok || payload.archiveBytes === undefined || payload.freeBytes === undefined || payload.usedPercent === undefined) {
				throw new Error(payload.error ?? `Ошибка сервера (${response.status}).`);
			}
			storagePercent!.textContent = `${new Intl.NumberFormat('ru-RU', { maximumFractionDigits: 1 }).format(payload.usedPercent)}%`;
			storageCaption!.textContent = `Архив: ${formatStorageBytes(payload.archiveBytes)} · Свободно: ${formatStorageBytes(payload.freeBytes)}`;
			storageMeter!.style.width = `${payload.usedPercent}%`;
			storageTrack!.setAttribute('aria-valuenow', String(payload.usedPercent));
			storageTrack!.setAttribute('aria-valuetext', `${payload.usedPercent}% диска занято`);
		} catch (error) {
			console.error('Не удалось загрузить сведения о хранилище:', error);
			storagePercent!.textContent = 'Недоступно';
			storageCaption!.textContent = error instanceof Error ? error.message : 'Не удалось получить сведения о хранилище.';
			storageTrack!.setAttribute('aria-valuetext', 'Сведения о диске недоступны');
		}
	}

	function formatUpdated(value: string): string {
		const date = new Date(value);
		if (Number.isNaN(date.valueOf())) return value;
		return new Intl.DateTimeFormat('ru-RU', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' })
			.format(date).replace(',', '');
	}

	function selectCatalogView(view: string) {
		if (view === 'favorites') return;
		activeTab = view === 'recent' ? 'recent' : 'all';
		currentPage = 0;
		document.querySelectorAll<HTMLButtonElement>('.tab').forEach((tab) => {
			const selected = tab.dataset.tab === activeTab;
			tab.classList.toggle('active-tab', selected);
			tab.setAttribute('aria-selected', String(selected));
		});
		document.querySelectorAll<HTMLElement>('.nav-item[data-catalog-view]').forEach((item) => {
			const selected = item.dataset.catalogView === activeTab;
			item.classList.toggle('selected', selected);
			if (selected) item.setAttribute('aria-current', 'page');
			else item.removeAttribute('aria-current');
		});
		if (demoData) updateRows();
		else void loadCatalog();
	}

	function renderRow(doc: Record<string, string | number | null>): HTMLTableRowElement {
		const row = document.createElement('tr');
		row.className = 'document-row';
		const values = {
			id: String(doc.id ?? ''),
			title: String(doc.title ?? ''),
			number: String(doc.number ?? ''),
			date: String(doc.date ?? ''),
			dateIso: String(doc.dateIso ?? ''),
			type: String(doc.type ?? 'Иной документ'),
			status: String(doc.status ?? 'Проект'),
			department: String(doc.department ?? ''),
			updated: formatUpdated(String(doc.updated ?? '')),
			files: String(doc.files ?? 0),
			owner: String(doc.owner ?? ''),
			description: String(doc.description ?? ''),
		};
		for (const [key, value] of Object.entries(values)) row.dataset[key] = value;
		const iconClass = values.type === 'Договор' ? 'contract' : values.type === 'Инструкция' ? 'instruction' : 'order';
		const className = statusClasses[values.status] ?? 'draft';
		row.innerHTML = `
			<td class="check-col"><input type="checkbox" aria-label="Выбрать ${escapeHtml(values.title)}" /></td>
			<td class="document-name-cell"><button class="document-link" type="button">
				<span class="file-type-icon ${iconClass}"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 2.8h7l4 4v10.4H5V2.8Z"/><path d="M12 3v4h4M8 11h5M8 14h3"/></svg></span>
				<span class="document-title-copy"><strong>${escapeHtml(values.title)}</strong><small>Обновлён ${escapeHtml(values.updated)}</small></span>
			</button></td>
			<td class="number-cell"><strong>№ ${escapeHtml(values.number)}</strong><span>${escapeHtml(values.date)}</span></td>
			<td><span class="type-label">${escapeHtml(values.type)}</span></td>
			<td><span class="status-badge ${className}"><i></i>${escapeHtml(values.status)}</span></td>
			<td class="department-cell">${escapeHtml(values.department)}</td>
			<td><button class="file-count" type="button" aria-label="${escapeHtml(values.files)} файла"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M11.5 5.5 7 10a2.1 2.1 0 0 0 3 3l5-5a3.5 3.5 0 0 0-5-5l-6 6a5 5 0 0 0 7 7l4.5-4.5"/></svg>${escapeHtml(values.files)}</button></td>
			<td class="updated-cell">${escapeHtml(values.updated)}</td>
			<td><button class="row-more" type="button" aria-label="Действия для ${escapeHtml(values.title)}"><svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="4" cy="10" r="1"/><circle cx="10" cy="10" r="1"/><circle cx="16" cy="10" r="1"/></svg></button></td>`;
		return row;
	}

	function bindRowActions() {
		rows.forEach((row) => {
			row.querySelector<HTMLButtonElement>('.document-link')!.addEventListener('click', () => showDocument(row));
			row.querySelector<HTMLButtonElement>('.file-count')!.addEventListener('click', () => showDocument(row));
			row.querySelector<HTMLButtonElement>('.row-more')!.addEventListener('click', () => showDocument(row));
		});
	}

	function updateRows() {
		const query = searchInput.value.trim().toLocaleLowerCase('ru');
		const visibleRows = rows.filter((row) => {
			const matchesQuery = ['title', 'number', 'type', 'status', 'department', 'owner', 'description']
				.some((key) => getRowValue(row, key).toLocaleLowerCase('ru').includes(query));
			const matchesStatus = !statusFilter.value || getRowValue(row, 'status') === statusFilter.value;
			const matchesType = !typeFilter.value || getRowValue(row, 'type') === typeFilter.value;
			const matchesDepartment = !departmentFilter.value || getRowValue(row, 'department') === departmentFilter.value;
			const rowDate = getRowValue(row, 'dateIso');
			const matchesDateFrom = !dateFromFilter.value || !rowDate || rowDate >= dateFromFilter.value;
			const matchesDateTo = !dateToFilter.value || !rowDate || rowDate <= dateToFilter.value;
			const matchesTab = demoData ? activeTab !== 'mine' || getRowValue(row, 'owner') === currentUserName : true;
			const matchesRecent = demoData
				? activeTab !== 'recent' || ['Сегодня', 'Вчера'].some((day) => getRowValue(row, 'updated').startsWith(day))
				: true;
			return matchesQuery && matchesStatus && matchesType && matchesDepartment && matchesDateFrom && matchesDateTo && matchesTab && matchesRecent;
		});

		const key = sortSelect.value;
		visibleRows.sort((first, second) => {
			const firstValue = getRowValue(first, key);
			const secondValue = getRowValue(second, key);
			return key === 'title' || key === 'number'
				? firstValue.localeCompare(secondValue, 'ru', { numeric: true })
				: secondValue.localeCompare(firstValue, 'ru', { numeric: true });
		});
		visibleRows.forEach((row) => row.parentElement?.append(row));
		rows.forEach((row) => { row.hidden = !visibleRows.includes(row); });
		emptyState.hidden = visibleRows.length > 0;
		resultCount.textContent = resultTotal.toLocaleString('ru-RU');
		shownCount.textContent = String(visibleRows.length);
		document.querySelector<HTMLElement>('.table-footer')!.firstElementChild!.innerHTML =
			`Показано <strong id="shown-count">${visibleRows.length}</strong> из ${resultTotal.toLocaleString('ru-RU')} документов`;
		const hasFilters = Boolean(statusFilter.value || typeFilter.value || departmentFilter.value || dateFromFilter.value || dateToFilter.value);
		filterIndicator.hidden = !hasFilters;
	}

	function clearFilters() {
		searchInput.value = '';
		statusFilter.value = '';
		typeFilter.value = '';
		departmentFilter.value = '';
		dateFromFilter.value = '';
		dateToFilter.value = '';
		activeTab = 'all';
		document.querySelectorAll<HTMLButtonElement>('.tab').forEach((tab) => {
			const selected = tab.dataset.tab === 'all';
			tab.classList.toggle('active-tab', selected);
			tab.setAttribute('aria-selected', String(selected));
		});
		currentPage = 0;
		if (demoData) updateRows();
		else void loadCatalog();
	}

	function showToast(message: string) {
		toast.textContent = message;
		toast.classList.add('toast-visible');
		window.clearTimeout(toastTimeout);
		toastTimeout = window.setTimeout(() => toast.classList.remove('toast-visible'), 2800);
	}

	async function showDocument(row: HTMLTableRowElement) {
		const status = getRowValue(row, 'status');
		currentDocumentId = getRowValue(row, 'id') || null;
		dialog.querySelector<HTMLElement>('#dialog-title')!.textContent = getRowValue(row, 'title');
		const statusElement = dialog.querySelector<HTMLElement>('.dialog-status')!;
		statusElement.replaceChildren();
		const badge = document.createElement('span');
		badge.className = `status-badge ${statusClasses[status] ?? ''}`;
		const dot = document.createElement('i');
		badge.append(dot, document.createTextNode(status));
		statusElement.append(badge);
		dialog.querySelector<HTMLElement>('.dialog-description')!.textContent = getRowValue(row, 'description');
		dialog.querySelector<HTMLElement>('.meta-number')!.textContent = `№ ${getRowValue(row, 'number')} · ${getRowValue(row, 'date')}`;
		dialog.querySelector<HTMLElement>('.meta-type')!.textContent = getRowValue(row, 'type');
		dialog.querySelector<HTMLElement>('.meta-department')!.textContent = getRowValue(row, 'department');
		dialog.querySelector<HTMLElement>('.meta-owner')!.textContent = getRowValue(row, 'owner');
		dialog.querySelector<HTMLElement>('.meta-files')!.textContent = `${getRowValue(row, 'files')} файла`;
		dialog.querySelector<HTMLElement>('.meta-updated')!.textContent = getRowValue(row, 'updated');
		const note = document.querySelector<HTMLElement>('#demo-note')!;
		note.hidden = !demoData;
		const editButton = document.querySelector<HTMLButtonElement>('#edit-document')!;
		const deleteButton = document.querySelector<HTMLButtonElement>('#delete-document')!;
		editButton.hidden = demoData || !currentUserName;
		deleteButton.hidden = demoData || !document.querySelector('.main-content')?.getAttribute('data-user-role')?.includes('admin');
		const filesContainer = document.querySelector<HTMLElement>('#dialog-files')!;
		filesContainer.replaceChildren();
		document.querySelector<HTMLElement>('.dialog-files-heading strong')!.textContent = 'Файлы документа';
		document.querySelector<HTMLButtonElement>('#add-file-button')!.hidden = demoData;
		document.querySelector<HTMLButtonElement>('#add-file-button')!.hidden =
			demoData || document.querySelector('.main-content')?.getAttribute('data-user-role') === 'reader';
		if (!demoData && currentDocumentId) {
			try {
				const response = await fetch(`/api/documents/${encodeURIComponent(currentDocumentId)}`);
				if (!response.ok) throw new Error('Не удалось загрузить карточку документа.');
				const { document: details } = await response.json() as { document: {
					files: Array<{ id: string; name: string; version: number; size: string; kind: string | null; isCurrent: boolean }>;
					description: string; owner: string | null;
				} };
				dialog.querySelector<HTMLElement>('.dialog-description')!.textContent = details.description ?? '';
				dialog.querySelector<HTMLElement>('.meta-owner')!.textContent = details.owner ?? 'Не назначен';
				dialog.querySelector<HTMLElement>('.meta-files')!.textContent = `${details.files.length} файла`;
				for (const file of details.files) {
					const item = document.createElement('div');
					item.className = 'dialog-file-item';
					const icon = document.createElement('span');
					icon.className = 'dialog-file-type';
					icon.textContent = file.name.split('.').pop()?.slice(0, 4).toUpperCase() ?? 'FILE';
					icon.setAttribute('aria-hidden', 'true');
					const name = document.createElement('span');
					name.textContent = file.name;
					const detailsText = document.createElement('small');
					detailsText.textContent = `${file.kind ?? 'Файл'} · v${file.version} · ${(Number(file.size) / 1024 / 1024).toFixed(2)} МБ`;
					const download = document.createElement('a');
					download.href = `/api/files/${encodeURIComponent(file.id)}/download`;
					download.textContent = 'Скачать';
					download.className = 'file-action-link';
					item.append(icon, name, detailsText);
					const actions = document.createElement('div');
					actions.className = 'file-item-actions';
					actions.append(download);
					if (document.querySelector('.main-content')?.getAttribute('data-user-role') !== 'reader') {
						const history = document.createElement('button');
						history.className = 'file-action-link';
						history.type = 'button';
						history.textContent = 'Версии';
						history.addEventListener('click', () => showVersions(file.id));
						actions.append(history);
						if (file.name.toLowerCase().endsWith('.docx') || file.name.toLowerCase().endsWith('.xlsx')) {
							const office = document.createElement('button');
							office.className = 'file-action-link';
							office.type = 'button';
							office.textContent = 'Просмотр в Office';
							office.title = 'Файл откроется для просмотра. Чтобы сохранить изменения, скачайте его и загрузите новую версию в архив.';
							office.addEventListener('click', () => openInOffice(file.id));
							actions.append(office);
						}
					}
					item.append(actions);
					filesContainer.append(item);
				}
				if (details.files.length === 0) {
					const noFiles = document.createElement('span');
					noFiles.className = 'no-files';
					noFiles.textContent = 'Файлы ещё не загружены.';
					filesContainer.append(noFiles);
				}
			} catch {
				showToast('Не удалось загрузить карточку документа.');
				return;
			}
		}
		dialog.showModal();
	}

	async function loadCatalog() {
		const sequence = ++requestSequence;
		try {
			const params = new URLSearchParams({
				limit: '10',
				offset: String(currentPage * 10),
				sort: sortSelect.value,
				q: searchInput.value.trim(),
				status: statusFilter.value,
				type: typeFilter.value,
				department: departmentFilter.value,
				from: dateFromFilter.value,
				to: dateToFilter.value,
			});
			if (activeTab === 'mine') params.set('mine', '1');
			if (activeTab === 'recent') params.set('recent', '1');
			const response = await fetch(`/api/documents?${params}`);
			if (!response.ok) throw new Error('Не удалось загрузить каталог.');
			const payload = await response.json() as {
				documents: Array<Record<string, string | number | null>>;
				total: number;
				archiveTotal: number;
				statusSummary?: Record<string, number>;
				createdThisMonth?: number;
			};
			if (sequence !== requestSequence) return;
			demoData = false;
			resultTotal = payload.total;
			totalDocuments = payload.archiveTotal;
			const body = document.querySelector<HTMLTableSectionElement>('#document-rows')!;
			body.replaceChildren(...payload.documents.map(renderRow));
			rows = Array.from(body.querySelectorAll<HTMLTableRowElement>('.document-row'));
			bindRowActions();
			resultCount.textContent = resultTotal.toLocaleString('ru-RU');
			document.querySelector<HTMLElement>('.nav-count')!.textContent = totalDocuments.toLocaleString('ru-RU');
			document.querySelector<HTMLElement>('.stat-card:nth-child(1) .stat-value')!.textContent = totalDocuments.toLocaleString('ru-RU');
			const active = payload.statusSummary?.['Действует'] ?? 0;
			const reviewing = payload.statusSummary?.['На согласовании'] ?? 0;
			document.querySelector<HTMLElement>('.stat-card:nth-child(2) .stat-value')!.textContent = active.toLocaleString('ru-RU');
			document.querySelector<HTMLElement>('.stat-card:nth-child(3) .stat-value')!.textContent = reviewing.toLocaleString('ru-RU');
			document.querySelector<HTMLElement>('.stat-card:nth-child(4) .stat-value')!.textContent =
				(payload.createdThisMonth ?? 0).toLocaleString('ru-RU');
			document.querySelector<HTMLElement>('.stat-card:nth-child(2) .stat-foot span:last-child')!.textContent =
				`${totalDocuments ? (active / totalDocuments * 100).toFixed(1).replace('.', ',') : '0'}% от общего числа`;
			document.querySelector<HTMLElement>('.environment-tag')!.innerHTML = '<i></i> Подключено к архиву';
			renderPagination(payload.total);
			updateRows();
		} catch {
			if (sequence !== requestSequence) return;
			demoData = false;
			totalDocuments = 0;
			resultTotal = 0;
			rows.forEach((row) => row.remove());
			rows = [];
			resultCount.textContent = '0';
			document.querySelector<HTMLElement>('.nav-count')!.textContent = '0';
			document.querySelector<HTMLElement>('.environment-tag')!.innerHTML = '<i></i> Нет соединения';
			document.querySelectorAll<HTMLElement>('.stat-card .stat-value').forEach((value) => { value.textContent = '0'; });
			document.querySelector<HTMLElement>('.stat-card:nth-child(2) .stat-foot span:last-child')!.textContent = '0% от общего числа';
			renderPagination(0);
			updateRows();
			showToast('Не удалось загрузить каталог. Проверьте подключение к базе данных.');
		}
	}

	function renderPagination(total: number) {
		const container = document.querySelector<HTMLElement>('.pagination')!;
		container.replaceChildren();
		const pages = Math.max(1, Math.ceil(total / 10));
		const addButton = (label: string, page: number, disabled = false, current = false) => {
			const button = document.createElement('button');
			button.className = current ? 'page-number current-page' : 'page-number';
			button.type = 'button';
			button.textContent = label;
			button.disabled = disabled;
			if (current) button.setAttribute('aria-current', 'page');
			button.addEventListener('click', () => {
				currentPage = page;
				void loadCatalog();
			});
			container.append(button);
		};
		addButton('‹', Math.max(0, currentPage - 1), currentPage === 0);
		const start = Math.max(0, Math.min(currentPage - 2, pages - 5));
		const end = Math.min(pages, Math.max(start + 5, currentPage + 3));
		for (let page = start; page < end; page++) {
			addButton(String(page + 1), page, false, page === currentPage);
		}
		if (end < pages) {
			const ellipsis = document.createElement('span');
			ellipsis.className = 'page-ellipsis';
			ellipsis.textContent = '…';
			container.append(ellipsis);
			addButton(String(pages), pages - 1);
		}
		addButton('›', Math.min(pages - 1, currentPage + 1), currentPage >= pages - 1);
	}

	async function openCreateForm(row?: HTMLTableRowElement) {
		editingDocumentId = row?.dataset.id ?? null;
		form.reset();
		document.querySelector<HTMLElement>('#form-dialog-title')!.textContent = row ? 'Редактирование документа' : 'Новый документ';
		document.querySelector<HTMLButtonElement>('#save-document')!.textContent = row ? 'Сохранить изменения' : 'Сохранить документ';
		const formError = document.querySelector<HTMLElement>('#form-error')!;
		formError.hidden = true;
		if (row) {
			(form.elements.namedItem('title') as HTMLInputElement).value = row.dataset.title ?? '';
			(form.elements.namedItem('date') as HTMLInputElement).value = row.dataset.dateIso ?? '';
		}
		try {
			const response = await fetch('/api/admin/dictionaries');
			if (!response.ok) throw new Error('Не удалось загрузить справочники.');
			const { items } = await response.json() as { items: Array<{ type: string; name: string }> };
			for (const [field, kind] of [['type', 'doc_type'], ['department', 'department']] as const) {
				const select = form.elements.namedItem(field) as HTMLSelectElement;
				const placeholder = select.options[0];
				select.replaceChildren(placeholder);
				for (const item of items.filter((entry) => entry.type === kind)) {
					const option = document.createElement('option');
					option.value = item.name;
					option.textContent = item.name;
					select.append(option);
				}
				if (row?.dataset[field]) select.value = row.dataset[field]!;
			}
			formDialog.showModal();
		} catch {
			showToast('Не удалось загрузить справочники. Проверьте подключение к серверу.');
		}
	}

	async function showVersions(fileId: string) {
		try {
			const response = await fetch(`/api/files/${encodeURIComponent(fileId)}/versions`);
			const payload = await response.json() as { error?: string; versions?: Array<{
				id: string; name: string; version: number; size: string; comment: string | null;
				uploadedAt: string; uploadedBy: string | null; isCurrent: boolean;
			}> };
			if (!response.ok || !payload.versions) throw new Error(payload.error ?? 'Не удалось получить историю версий.');
			const filesContainer = document.querySelector<HTMLElement>('#dialog-files')!;
			filesContainer.replaceChildren();
			for (const version of payload.versions) {
				const item = document.createElement('div');
				item.className = 'dialog-file-item version-item';
				const icon = document.createElement('span');
				icon.className = 'dialog-file-type';
				icon.textContent = version.name.split('.').pop()?.slice(0, 4).toUpperCase() ?? 'FILE';
				icon.setAttribute('aria-hidden', 'true');
				const name = document.createElement('span');
				name.textContent = `${version.name} · v${version.version}${version.isCurrent ? ' · Актуальная' : ''}`;
				const details = document.createElement('small');
				details.textContent = `${version.uploadedBy ?? 'Пользователь удалён'} · ${formatUpdated(version.uploadedAt)} · ${(Number(version.size) / 1024 / 1024).toFixed(2)} МБ${version.comment ? ` · ${version.comment}` : ''}`;
				item.append(icon, name, details);
				const actions = document.createElement('div');
				actions.className = 'file-item-actions';
				const download = document.createElement('a');
				download.href = `/api/files/${encodeURIComponent(version.id)}/download`;
				download.textContent = 'Скачать';
				download.className = 'file-action-link';
				actions.append(download);
				if (!version.isCurrent) {
					const restore = document.createElement('button');
					restore.type = 'button';
					restore.textContent = 'Восстановить';
					restore.className = 'file-action-link';
					restore.addEventListener('click', async () => {
						const restored = await fetch(`/api/files/${encodeURIComponent(version.id)}/restore`, { method: 'POST' });
						if (!restored.ok) {
							const result = await restored.json() as { error?: string };
							showToast(result.error ?? 'Не удалось восстановить версию.');
							return;
						}
						showToast('Предыдущая версия восстановлена как новая.');
						if (currentDocumentId) {
							const current = rows.find((row) => row.dataset.id === currentDocumentId);
							if (current) await showDocument(current);
						}
					});
					actions.append(restore);
				}
				item.append(actions);
				filesContainer.append(item);
			}
			const heading = document.querySelector<HTMLElement>('.dialog-files-heading strong')!;
			heading.textContent = 'История версий';
			dialog.showModal();
		} catch (error) {
			showToast(error instanceof Error ? error.message : 'Не удалось получить историю версий.');
		}
	}

	async function openInOffice(fileId: string) {
		try {
			const response = await fetch(`/api/files/${encodeURIComponent(fileId)}/edit-token`, { method: 'POST' });
			const payload = await response.json() as { url?: string; error?: string };
			if (!response.ok || !payload.url) throw new Error(payload.error ?? 'Не удалось подготовить открытие файла.');
			window.location.assign(payload.url);
		} catch (error) {
			showToast(error instanceof Error ? error.message : 'Не удалось открыть файл.');
		}
	}

	let searchTimeout: number | undefined;
	const reloadCatalog = () => {
		currentPage = 0;
		if (demoData) updateRows();
		else void loadCatalog();
	};
	searchInput.addEventListener('input', () => {
		if (demoData) updateRows();
		else {
			window.clearTimeout(searchTimeout);
			searchTimeout = window.setTimeout(() => { currentPage = 0; void loadCatalog(); }, 250);
		}
	});
	statusFilter.addEventListener('change', reloadCatalog);
	typeFilter.addEventListener('change', reloadCatalog);
	departmentFilter.addEventListener('change', reloadCatalog);
	dateFromFilter.addEventListener('change', reloadCatalog);
	dateToFilter.addEventListener('change', reloadCatalog);
	sortSelect.addEventListener('change', reloadCatalog);

	document.querySelector<HTMLButtonElement>('#filters-toggle')!.addEventListener('click', (event) => {
		const button = event.currentTarget as HTMLButtonElement;
		const expanded = button.getAttribute('aria-expanded') === 'true';
		button.setAttribute('aria-expanded', String(!expanded));
		filterPanel.hidden = expanded;
	});

	document.querySelector<HTMLButtonElement>('#clear-filters')!.addEventListener('click', clearFilters);
	document.querySelector<HTMLButtonElement>('#empty-reset')!.addEventListener('click', clearFilters);
	document.querySelectorAll<HTMLButtonElement>('.tab').forEach((tab) => tab.addEventListener('click', () => {
		selectCatalogView(tab.dataset.tab ?? 'all');
	}));
	document.querySelectorAll<HTMLAnchorElement>('.nav-item[data-catalog-view]').forEach((item) => {
		item.addEventListener('click', (event) => {
			event.preventDefault();
			selectCatalogView(item.dataset.catalogView ?? 'all');
		});
	});
	document.querySelector<HTMLButtonElement>('.nav-item[data-catalog-view="favorites"]')!.addEventListener('click', () => {
		showToast('Раздел «Избранное» пока не подключён.');
	});

	rows.forEach((row) => {
		row.querySelector<HTMLButtonElement>('.document-link')!.addEventListener('click', () => showDocument(row));
		row.querySelector<HTMLButtonElement>('.file-count')!.addEventListener('click', () => showDocument(row));
		row.querySelector<HTMLButtonElement>('.row-more')!.addEventListener('click', () => showDocument(row));
	});

	dialog.querySelectorAll<HTMLButtonElement>('.dialog-close, .dialog-close-action').forEach((button) => {
		button.addEventListener('click', () => dialog.close());
	});
	document.querySelector<HTMLButtonElement>('#add-document')?.addEventListener('click', () => void openCreateForm());
	document.querySelector<HTMLButtonElement>('#edit-document')!.addEventListener('click', () => {
		const row = rows.find((item) => item.dataset.id === currentDocumentId);
		if (!row) return;
		dialog.close();
		void openCreateForm(row);
	});
	document.querySelector<HTMLButtonElement>('#delete-document')!.addEventListener('click', async () => {
		if (!currentDocumentId || !window.confirm('Удалить документ и скрыть связанные файлы?')) return;
		try {
			const response = await fetch(`/api/documents/${encodeURIComponent(currentDocumentId)}`, { method: 'DELETE' });
			if (!response.ok) {
				const result = await response.json() as { error?: string };
				throw new Error(result.error ?? 'Не удалось удалить документ.');
			}
			dialog.close();
			showToast('Документ удалён.');
			await loadCatalog();
		} catch (error) {
			showToast(error instanceof Error ? error.message : 'Не удалось удалить документ.');
		}
	});
	document.querySelector<HTMLButtonElement>('#add-file-button')!.addEventListener('click', () => {
		if (!currentDocumentId) return;
		const picker = document.createElement('input');
		picker.type = 'file';
		picker.multiple = true;
		picker.accept = '.docx,.xlsx,.pdf';
		picker.addEventListener('change', async () => {
			const selected = Array.from(picker.files ?? []);
			for (const file of selected) {
				const formData = new FormData();
				formData.append('file', file);
				formData.append('fileKind', 'Исходный документ');
				try {
					const response = await fetch(`/api/documents/${encodeURIComponent(currentDocumentId!)}/files`, { method: 'POST', body: formData });
					const result = await response.json() as { error?: string };
					if (!response.ok) throw new Error(result.error ?? `Не удалось загрузить ${file.name}.`);
				} catch (error) {
					showToast(error instanceof Error ? error.message : `Не удалось загрузить ${file.name}.`);
					return;
				}
			}
			showToast(selected.length ? 'Файлы загружены.' : 'Файлы не выбраны.');
			const row = rows.find((item) => item.dataset.id === currentDocumentId);
			if (row) await showDocument(row);
			await loadCatalog();
		});
		picker.click();
	});
	form.addEventListener('submit', async (event) => {
		event.preventDefault();
		const saveButton = document.querySelector<HTMLButtonElement>('#save-document')!;
		const formError = document.querySelector<HTMLElement>('#form-error')!;
		const title = (form.elements.namedItem('title') as HTMLInputElement).value.trim();
		const date = (form.elements.namedItem('date') as HTMLInputElement).value;
		const type = (form.elements.namedItem('type') as HTMLSelectElement).value;
		const department = (form.elements.namedItem('department') as HTMLSelectElement).value;
		const selectedFiles = Array.from((form.elements.namedItem('files') as HTMLInputElement).files ?? []);
		formError.hidden = true;
		saveButton.disabled = true;
		try {
			const payload = {
				title,
				date,
				type,
				department,
			};
			const wasEditing = Boolean(editingDocumentId);
			let response = await fetch(
				wasEditing ? `/api/documents/${encodeURIComponent(editingDocumentId!)}` : '/api/documents',
				{
					method: wasEditing ? 'PATCH' : 'POST',
					headers: { 'content-type': 'application/json' },
					body: JSON.stringify(payload),
				},
			);
			let result = await response.json() as {
				id?: string; error?: string; duplicates?: Array<{ id: string; title: string; number: string }>;
			};
			if (response.status === 409 && result.duplicates && !wasEditing) {
				const matches = result.duplicates.map((item) => `№ ${item.number} — ${item.title}`).join('\n');
				if (window.confirm(`${result.error}\n\n${matches}\n\nСоздать документ, несмотря на совпадения?`)) {
					response = await fetch('/api/documents', {
						method: 'POST',
						headers: { 'content-type': 'application/json' },
						body: JSON.stringify({ ...payload, allowDuplicate: true }),
					});
					result = await response.json() as { id?: string; error?: string };
				}
			}
			if (!response.ok) throw new Error(result.error ?? 'Не удалось сохранить карточку.');
			const savedId = result.id ?? editingDocumentId;
			editingDocumentId = savedId ?? null;
			for (const file of selectedFiles) {
				const formData = new FormData();
				formData.append('file', file);
				formData.append('fileKind', 'Исходный документ');
				const uploadResponse = await fetch(`/api/documents/${encodeURIComponent(savedId!)}/files`, { method: 'POST', body: formData });
				const uploadResult = await uploadResponse.json() as { error?: string };
				if (!uploadResponse.ok) {
					throw new Error(`Карточка сохранена, но файл «${file.name}» не загружен: ${uploadResult.error ?? 'ошибка сервера'}`);
				}
			}
			formDialog.close();
			showToast(wasEditing ? 'Изменения сохранены.' : 'Документ создан.');
			currentPage = 0;
			await loadCatalog();
		} catch (error) {
			formError.textContent = error instanceof Error ? error.message : 'Не удалось сохранить документ.';
			formError.hidden = false;
			if (!editingDocumentId && selectedFiles.length) {
				saveButton.textContent = 'Повторить загрузку файлов';
			}
		} finally {
			saveButton.disabled = false;
		}
	});
	document.querySelectorAll<HTMLButtonElement>('.form-close').forEach((button) => {
		button.addEventListener('click', () => formDialog.close());
	});
	async function logout() {
		try {
			const response = await fetch('/api/auth/logout', { method: 'POST' });
			if (response.status === 503) {
				window.location.assign('/login?logout=partial');
				return;
			}
			if (!response.ok) throw new Error('Сервер не подтвердил завершение сессии.');
			window.location.assign('/login');
		} catch {
			showToast('Не удалось завершить сеанс. Проверьте соединение и повторите попытку.');
		}
	}
	document.querySelector<HTMLButtonElement>('#logout-button')?.addEventListener('click', logout);
	document.querySelector<HTMLButtonElement>('#mobile-logout-button')!.addEventListener('click', logout);
	document.querySelector<HTMLButtonElement>('#export-button')!.addEventListener('click', () => showToast('Экспорт появится следующим этапом.'));
	document.querySelectorAll<HTMLButtonElement>('.page-number, .page-arrow:not(:disabled)').forEach((button) => button.addEventListener('click', () => showToast('Постраничная навигация появится после загрузки каталога.')));
	document.querySelector<HTMLInputElement>('.check-col input[aria-label="Выбрать все документы"]')!.addEventListener('change', (event) => {
		const checked = (event.currentTarget as HTMLInputElement).checked;
		rows.filter((row) => !row.hidden).forEach((row) => {
			row.querySelector<HTMLInputElement>('.check-col input')!.checked = checked;
		});
	});

	document.addEventListener('keydown', (event) => {
		if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
			event.preventDefault();
			searchInput.focus();
		}
	});

	bindRowActions();
	updateRows();
	void loadCatalog();
	void loadStorageUsage();
	});
</script>

