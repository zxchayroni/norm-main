{
  "name": "shaky-shell",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/astro/bin/astro.mjs dev",
    "build": "node --env-file-if-exists=.env node_modules/astro/bin/astro.mjs build",
    "preview": "node --env-file-if-exists=.env node_modules/astro/bin/astro.mjs preview",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "admin:create": "node --env-file-if-exists=.env scripts/create-admin.mjs",
    "admin:password": "node --env-file-if-exists=.env scripts/set-admin-password.mjs",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.7",
    "argon2": "^0.45.1",
    "astro": "^7.3.6",
    "busboy": "^1.6.0",
    "exceljs": "^4.4.0",
    "otpauth": "^9.5.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "yauzl": "^3.4.0"
  },
  "allowScripts": {
    "esbuild": true,
    "argon2@0.45.1": true
  },
  "devDependencies": {
    "@types/busboy": "^1.5.5",
    "@types/qrcode": "^1.5.6",
    "@types/yauzl": "^3.4.0"
  }
}
